<Window
    x:Class="LaunchMe.UI.Views.MusicPlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:LaunchMe.UI.ViewModels"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="#DD0B0F19" KeyDown="RootGrid_KeyDown">
        <!-- Close Button (Top Right) -->
        <Button HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,32,32,0"
                Background="Transparent"
                BorderThickness="0"
                Padding="12"
                Command="{x:Bind ViewModel.DismissCommand}">
            <FontIcon Glyph="&#xE711;" FontSize="18" Foreground="#94A3B8" />
        </Button>

        <!-- Center Player & Visualizer -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" MaxWidth="520">
            <!-- Visualizer Container -->
            <Grid Width="280" Height="280" HorizontalAlignment="Center">
                <!-- Glowing Beats Outer Halo -->
                <Ellipse Width="270" Height="270"
                         Fill="#1E38BDF8"
                         Opacity="{x:Bind ViewModel.GlowPulse, Mode=OneWay}" />

                <!-- Vinyl Mode: Rotating Record -->
                <Grid Width="240" Height="240" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RenderTransform>
                        <RotateTransform Angle="{x:Bind ViewModel.VinylAngle, Mode=OneWay}" CenterX="120" CenterY="120" />
                    </Grid.RenderTransform>
                    <!-- Vinyl Grooves -->
                    <Ellipse Fill="#18181B" Stroke="#3F3F46" StrokeThickness="4" />
                    <Ellipse Width="180" Height="180" Stroke="#27272A" StrokeThickness="2" />
                    <Ellipse Width="120" Height="120" Stroke="#27272A" StrokeThickness="2" />
                    <!-- Center Label -->
                    <Ellipse Width="70" Height="70" Fill="#E11D48" />
                    <Ellipse Width="16" Height="16" Fill="#09090B" />
                </Grid>
            </Grid>

            <!-- Track Info -->
            <StackPanel HorizontalAlignment="Center" Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}"
                           FontSize="22" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="440" />
                <TextBlock Text="{x:Bind ViewModel.Artist, Mode=OneWay}"
                           FontSize="15" Foreground="#94A3B8" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.Album, Mode=OneWay}"
                           FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Seek Slider & Time -->
            <StackPanel Spacing="4">
                <Slider Value="{x:Bind ViewModel.ProgressFraction, Mode=OneWay}"
                        Minimum="0" Maximum="1" StepFrequency="0.001"
                        HorizontalAlignment="Stretch" />
                <Grid>
                    <TextBlock Text="{x:Bind ViewModel.PositionFormatted, Mode=OneWay}"
                               FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Left" />
                    <TextBlock Text="{x:Bind ViewModel.DurationFormatted, Mode=OneWay}"
                               FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

            <!-- Transport Controls -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24">
                <Button Background="Transparent" BorderThickness="0" Padding="12"
                        Command="{x:Bind ViewModel.PreviousCommand}">
                    <FontIcon Glyph="&#xE892;" FontSize="20" Foreground="White" />
                </Button>

                <Button Width="56" Height="56" CornerRadius="28" Background="#38BDF8" BorderThickness="0"
                        Command="{x:Bind ViewModel.PlayPauseCommand}">
                    <FontIcon Glyph="&#xE768;" FontSize="24" Foreground="Black" />
                </Button>

                <Button Background="Transparent" BorderThickness="0" Padding="12"
                        Command="{x:Bind ViewModel.NextCommand}">
                    <FontIcon Glyph="&#xE893;" FontSize="20" Foreground="White" />
                </Button>
            </StackPanel>

            <!-- Visualizer Mode Toggle -->
            <Button Content="Visualizer Mode"
                    FontSize="11"
                    HorizontalAlignment="Center"
                    Padding="12,4"
                    Command="{x:Bind ViewModel.CycleModeCommand}" />
        </StackPanel>
    </Grid>
</Window>
