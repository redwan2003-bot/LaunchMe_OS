<Window
    x:Class="LaunchMe.UI.Views.LauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:LaunchMe.UI.ViewModels"
    xmlns:spaces="using:LaunchMe.Contracts.Spaces"
    xmlns:workflows="using:LaunchMe.Contracts.Workflows"
    xmlns:theming="using:LaunchMe.UI.Theming"
    xmlns:wallpaper="using:LaunchMe.UI.Wallpaper"
    xmlns:widgets="using:LaunchMe.UI.Widgets.Catalog"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="#FF080A0F" KeyDown="RootGrid_KeyDown" UseLayoutRounding="False">
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Toggle Edit Mode" Command="{x:Bind ViewModel.ToggleEditModeCommand}" />
                <MenuFlyoutItem Text="Toggle Widget Drawer" Command="{x:Bind ViewModel.ToggleWidgetDrawerCommand}" />
                <MenuFlyoutItem Text="Refresh Apps" Command="{x:Bind ViewModel.RefreshAppsCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Settings &amp; Tint" Command="{x:Bind ViewModel.ToggleSettingsCommand}" />
            </MenuFlyout>
        </Grid.ContextFlyout>
        <!-- Live / Dynamic / Static Wallpaper layer -->
        <wallpaper:LiveWallpaperControl x:Name="WallpaperSurface"
                                        ViewModel="{x:Bind ViewModel.Wallpaper, Mode=OneWay}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" />

        <!-- Liquid Glass Acrylic & Tint overlay / dismiss catcher -->
        <theming:LiquidGlassOverlayControl x:Name="LiquidGlassBackdrop"
                                           VisualState="{x:Bind ViewModel.ThemeVisualState, Mode=OneWay}"
                                           PointerPressed="DismissBackdrop_PointerPressed" />

        <Grid Margin="48,32,48,40" UseLayoutRounding="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Center: Specular Glass Search Capsule with #00F0FF Glow -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Width="690" Spacing="10">
                <Border CornerRadius="20"
                        Background="#D90E131F"
                        BorderBrush="{StaticResource SpecularCyanHaloBorderBrush}"
                        BorderThickness="1"
                        UseLayoutRounding="False"
                        Padding="2">
                    <Border CornerRadius="18"
                            Background="#E6161D2E"
                            BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                            BorderThickness="0.5"
                            UseLayoutRounding="False"
                            Padding="14,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0" Glyph="&#xE721;" Foreground="#FF00F0FF" Margin="4,0,10,0" FontSize="16" />

                            <TextBox x:Name="SearchBox"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#FFF8FAFC"
                                     PlaceholderText="Search apps, files, math, or press TAB for Emoji..."
                                     PlaceholderForeground="#FF64748B"
                                     FontFamily="Segoe UI Variable Display"
                                     FontSize="16"
                                     Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="SearchBox_PreviewKeyDown" />

                            <!-- Search / Emoji Mode Badge -->
                            <Border Grid.Column="2"
                                    Style="{StaticResource EditorialMicroBadge}"
                                    Background="#2200F0FF"
                                    BorderBrush="#8800F0FF"
                                    Visibility="{x:Bind ViewModel.EmojiModeBadgeVisibility, Mode=OneWay}">
                                <TextBlock Text="EMOJI (TAB)" Style="{StaticResource EditorialMicroBadgeTextStyle}" />
                            </Border>
                        </Grid>
                    </Border>
                </Border>

                <!-- Search Results Dropdown Overlay -->
                <Border x:Name="SearchResultsPopup"
                        Background="#E6161D2E"
                        BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                        BorderThickness="0.5"
                        UseLayoutRounding="False"
                        CornerRadius="18"
                        MaxHeight="380"
                        Visibility="{x:Bind ViewModel.SearchResultsVisibility, Mode=OneWay}">
                    <ListView x:Name="SearchResultsList"
                              ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                              SelectedIndex="{x:Bind ViewModel.SelectedSearchIndex, Mode=TwoWay}"
                              ItemClick="SearchResultsList_ItemClick"
                              IsItemClickEnabled="True">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:UnifiedSearchResultViewModel">
                                <Grid Padding="10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind CategoryGlyph}" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" Foreground="#FF00F0FF"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Foreground="#FFF8FAFC" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Subtitle}" Foreground="#FF94A3B8" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind CategoryName}" Foreground="#FF64748B" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>

            <!-- Main Content Area + Right-Side Bento Widget Drawer -->
            <Grid Grid.Row="1" Margin="0,18,0,16" UseLayoutRounding="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Category Pills Bar -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,14">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Content="{x:Bind}"
                                        Tag="{x:Bind}"
                                        Click="CategoryButton_Click"
                                        Background="#D90E131F"
                                        BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                        BorderThickness="0.5"
                                        Foreground="#FFF8FAFC"
                                        CornerRadius="16"
                                        Padding="14,5"
                                        FontSize="12"
                                        FontWeight="SemiBold" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Main Page Items Grid (Virtualized Multi-Page Carousel with 64x64 Squircle Pedestals) -->
                <FlipView x:Name="LauncherFlipView"
                          Grid.Row="1"
                          Grid.Column="0"
                          ItemsSource="{x:Bind ViewModel.Pages, Mode=OneWay}"
                          SelectedIndex="{x:Bind ViewModel.CurrentPageIndex, Mode=TwoWay}">
                    <FlipView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LauncherPageViewModel">
                            <GridView ItemsSource="{x:Bind Items, Mode=OneWay}"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="LauncherGridView_ItemClick"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LauncherItemViewModel">
                                        <Grid Width="98" Height="112" Margin="12"
                                              Background="Transparent"
                                              CanDrag="{x:Bind IsEditModeActive, Mode=OneWay}"
                                              DragStarting="Item_DragStarting"
                                              Drop="Item_Drop"
                                              AllowDrop="True"
                                              UseLayoutRounding="False">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                                <Border Width="64"
                                                        Height="64"
                                                        CornerRadius="18"
                                                        Background="#D90E131F"
                                                        BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                                        BorderThickness="0.5"
                                                        UseLayoutRounding="False">
                                                    <Border CornerRadius="17"
                                                            Background="{x:Bind DominantGlowHex, Mode=OneWay}"
                                                            BorderBrush="{StaticResource SpecularInnerRimBrush}"
                                                            BorderThickness="0.5"
                                                            UseLayoutRounding="False">
                                                        <Image Source="{x:Bind IconImageSource, Mode=OneWay}" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Border>
                                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                           Foreground="#FFF8FAFC"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center"
                                                           Visibility="{x:Bind IsTitleVisible, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </DataTemplate>
                    </FlipView.ItemTemplate>
                </FlipView>

                <!-- Space Switcher & Workflow Luxury Pills Strip -->
                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="18"
                            Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.SpacesBarVisibility, Mode=OneWay}">
                        <TextBlock Text="SPACES"
                                   Style="{StaticResource EditorialMicroEyebrowStyle}"
                                   Foreground="#FF00F0FF"
                                   VerticalAlignment="Center" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Spaces, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="spaces:SpaceModel">
                                    <Button Content="{x:Bind Name}"
                                            Tag="{x:Bind SpaceId}"
                                            Click="SpaceButton_Click"
                                            Background="#1E00F0FF"
                                            BorderBrush="#6600F0FF"
                                            BorderThickness="0.5"
                                            Foreground="#FFF8FAFC"
                                            CornerRadius="12"
                                            Padding="12,4"
                                            FontSize="12"
                                            FontWeight="SemiBold" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.WorkflowsStripVisibility, Mode=OneWay}">
                        <TextBlock Text="WORKFLOWS"
                                   Style="{StaticResource EditorialMicroEyebrowStyle}"
                                   Foreground="#FF00FF9D"
                                   VerticalAlignment="Center" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Workflows, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="workflows:WorkflowDefinition">
                                    <Button Content="{x:Bind Name}"
                                            Tag="{x:Bind}"
                                            Click="WorkflowButton_Click"
                                            Background="#1E00FF9D"
                                            BorderBrush="#6600FF9D"
                                            BorderThickness="0.5"
                                            Foreground="#FFF8FAFC"
                                            CornerRadius="12"
                                            Padding="12,4"
                                            FontSize="12"
                                            FontWeight="SemiBold" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Right-Side Bento Widget Catalog Drawer -->
                <Border Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="1"
                        Width="360"
                        Margin="16,0,0,0"
                        Background="#D90E131F"
                        BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                        BorderThickness="0.5"
                        UseLayoutRounding="False"
                        CornerRadius="22"
                        Visibility="{x:Bind ViewModel.WidgetDrawerVisibility, Mode=OneWay}">
                    <widgets:WidgetCatalogView ViewModel="{x:Bind ViewModel.WidgetCatalog, Mode=OneWay}" />
                </Border>
            </Grid>

            <!-- Bottom Pagination Dots & Luxury Toolbar Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                <!-- Page Switcher Dots -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.PageIndicators, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,6,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PageIndicatorViewModel">
                            <Ellipse Width="8" Height="8"
                                     Fill="{x:Bind DotColor, Mode=OneWay}"
                                     PointerPressed="PageDot_PointerPressed"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Edit Mode Button -->
                <Button Content="{x:Bind ViewModel.EditModeButtonText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleEditModeCommand}"
                        Background="#D90E131F"
                        BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                        BorderThickness="0.5"
                        Foreground="#FFF8FAFC"
                        CornerRadius="12"
                        Padding="14,5" />

                <!-- Widgets Drawer Toggle Button -->
                <Button Content="Widgets"
                        Command="{x:Bind ViewModel.ToggleWidgetDrawerCommand}"
                        Background="#D90E131F"
                        BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                        BorderThickness="0.5"
                        Foreground="#FFF8FAFC"
                        CornerRadius="12"
                        Padding="14,5" />

                <!-- Settings & Diagnostics Toggle Button -->
                <Button Content="Settings"
                        Command="{x:Bind ViewModel.ToggleSettingsCommand}"
                        Background="#D90E131F"
                        BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                        BorderThickness="0.5"
                        Foreground="#FFF8FAFC"
                        CornerRadius="12"
                        Padding="14,5" />

                <!-- Exit App Button -->
                <Button Content="Exit"
                        Command="{x:Bind ViewModel.QuitAppCommand}"
                        Background="#33EF4444"
                        BorderBrush="#66EF4444"
                        BorderThickness="0.5"
                        Foreground="#FFFCA5A5"
                        CornerRadius="12"
                        Padding="14,5" />
            </StackPanel>
        </Grid>

        <!-- Smart Folder Modal Overlay -->
        <Grid x:Name="FolderModalOverlay"
              Background="#99080A0F"
              Visibility="{x:Bind ViewModel.FolderModalVisibility, Mode=OneWay}"
              PointerPressed="FolderScrim_PointerPressed">
            <Border x:Name="FolderModalCard"
                    Width="540"
                    MaxHeight="460"
                    Background="#E6161D2E"
                    BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                    BorderThickness="0.5"
                    UseLayoutRounding="False"
                    CornerRadius="24"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    PointerPressed="ModalCard_PointerPressed">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="SQUISH WORKSPACE FOLDER"
                                       Style="{StaticResource EditorialMicroEyebrowStyle}"
                                       Foreground="#FF00F0FF" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveFolderName, Mode=OneWay}"
                                       Style="{StaticResource EditorialBentoHeaderStyle}"
                                       FontSize="22" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                            <Button Content="3×5" Tag="3x5" Click="FolderDensityButton_Click" FontSize="11" Padding="8,4" CornerRadius="8" Background="#1AFFFFFF" Foreground="#FFE2E8F0" />
                            <Button Content="4×6" Tag="4x6" Click="FolderDensityButton_Click" FontSize="11" Padding="8,4" CornerRadius="8" Background="#1AFFFFFF" Foreground="#FFE2E8F0" />
                            <Button Content="5×8" Tag="5x8" Click="FolderDensityButton_Click" FontSize="11" Padding="8,4" CornerRadius="8" Background="#1AFFFFFF" Foreground="#FFE2E8F0" />
                            <Button Content="Close"
                                    Command="{x:Bind ViewModel.CloseFolderCommand}"
                                    Background="#1FFFFFFF"
                                    BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                    BorderThickness="0.5"
                                    Foreground="#FFF8FAFC"
                                    CornerRadius="10"
                                    Padding="12,4" />
                        </StackPanel>
                    </Grid>

                    <GridView x:Name="FolderGridView"
                              Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.ActiveFolderChildren, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="FolderGridView_ItemClick">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" Loaded="FolderWrapGrid_Loaded" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:LauncherItemViewModel">
                                <Grid Width="92" Height="104" Margin="8" Background="Transparent" UseLayoutRounding="False">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                        <Border Width="56"
                                                Height="56"
                                                CornerRadius="16"
                                                Background="#D90E131F"
                                                BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                                BorderThickness="0.5"
                                                UseLayoutRounding="False">
                                            <Image Source="{x:Bind IconImageSource, Mode=OneWay}" Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                   Foreground="#FFF8FAFC"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </Border>
        </Grid>

        <!-- Settings & Diagnostics Flyout Overlay (Leash & Squish Branded) -->
        <Grid x:Name="SettingsOverlay"
              Background="#99080A0F"
              Visibility="{x:Bind ViewModel.SettingsOverlayVisibility, Mode=OneWay}"
              PointerPressed="SettingsScrim_PointerPressed">
            <Border Width="460"
                    Background="#E6161D2E"
                    BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                    BorderThickness="0.5"
                    UseLayoutRounding="False"
                    CornerRadius="24"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    PointerPressed="ModalCard_PointerPressed">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="LEASH &amp; SQUISH ENGINE"
                                       Style="{StaticResource EditorialMicroEyebrowStyle}"
                                       Foreground="#FF00F0FF" />
                            <TextBlock Text="Settings &amp; Diagnostics"
                                       Style="{StaticResource EditorialBentoHeaderStyle}"
                                       FontSize="20" />
                        </StackPanel>
                        <Button Content="Close"
                                Command="{x:Bind ViewModel.ToggleSettingsCommand}"
                                HorizontalAlignment="Right"
                                Background="#1FFFFFFF"
                                BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                BorderThickness="0.5"
                                Foreground="#FFF8FAFC"
                                CornerRadius="10"
                                Padding="12,4" />
                    </Grid>

                    <!-- Leash & Squish Status Badges -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource EditorialMicroBadge}" Background="#1400FF9D" BorderBrush="#5500FF9D">
                            <TextBlock Text="LEASH REMOTE SYNC READY" Style="{StaticResource EditorialMicroBadgeTextStyle}" Foreground="#FF00FF9D" FontSize="9.5" />
                        </Border>
                        <Border Style="{StaticResource EditorialMicroBadge}" Background="#1400F0FF" BorderBrush="#5500F0FF">
                            <TextBlock Text="SQUISH BSP TILING" Style="{StaticResource EditorialMicroBadgeTextStyle}" Foreground="#FF00F0FF" FontSize="9.5" />
                        </Border>
                    </StackPanel>

                    <Border Background="#D90E131F"
                            BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                            BorderThickness="0.5"
                            UseLayoutRounding="False"
                            CornerRadius="14"
                            Padding="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="ACTIVE SPACE" Style="{StaticResource EditorialMicroEyebrowStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveSpaceName, Mode=OneWay}"
                                       Style="{StaticResource EditorialBentoHeaderStyle}"
                                       FontSize="16" />
                            <TextBlock Text="{x:Bind ViewModel.DiagnosticsSummary, Mode=OneWay}" Foreground="#FFCBD5E1" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.PlatformDiagnosticsText, Mode=OneWay}" Foreground="#FF94A3B8" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Bind ViewModel.SchedulerStatusText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ToggleSchedulerCommand}"
                                Background="#D90E131F"
                                BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                BorderThickness="0.5"
                                Foreground="#FFF8FAFC"
                                CornerRadius="10"
                                Padding="12,6" />
                        <Button Content="{x:Bind ViewModel.ThemeAssociationStatusText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ToggleThemeAssociationCommand}"
                                Background="#D90E131F"
                                BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                BorderThickness="0.5"
                                Foreground="#FFF8FAFC"
                                CornerRadius="10"
                                Padding="12,6" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="QUICK THEME TINT" Style="{StaticResource EditorialMicroEyebrowStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Cobalt" Tag="#1E40AF" Click="QuickTintButton_Click" Background="#1E40AF" BorderBrush="{StaticResource SpecularGlassChamferBrush}" BorderThickness="0.5" Foreground="White" CornerRadius="10" />
                            <Button Content="Emerald" Tag="#047857" Click="QuickTintButton_Click" Background="#047857" BorderBrush="{StaticResource SpecularGlassChamferBrush}" BorderThickness="0.5" Foreground="White" CornerRadius="10" />
                            <Button Content="Crimson" Tag="#9F1239" Click="QuickTintButton_Click" Background="#9F1239" BorderBrush="{StaticResource SpecularGlassChamferBrush}" BorderThickness="0.5" Foreground="White" CornerRadius="10" />
                            <Button Content="Obsidian" Tag="#080A0F" Click="QuickTintButton_Click" Background="#080A0F" BorderBrush="{StaticResource SpecularGlassChamferBrush}" BorderThickness="0.5" Foreground="White" CornerRadius="10" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Width="160"
                                     PlaceholderText="#00F0FF"
                                     Text="{x:Bind ViewModel.CustomHexTint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     CornerRadius="10" />
                            <Button Content="Apply HEX"
                                    Command="{x:Bind ViewModel.ApplyCustomHexTintCommand}"
                                    Background="#2400F0FF"
                                    BorderBrush="#FF00F0FF"
                                    BorderThickness="0.5"
                                    Foreground="#FF00F0FF"
                                    CornerRadius="10"
                                    Padding="12,6" />
                        </StackPanel>
                    </StackPanel>

                    <Button Content="Exit LaunchMe-Win"
                            Command="{x:Bind ViewModel.QuitAppCommand}"
                            HorizontalAlignment="Stretch"
                            Background="#33EF4444"
                            BorderBrush="#88EF4444"
                            BorderThickness="0.5"
                            Foreground="#FFFCA5A5"
                            CornerRadius="12"
                            Padding="12,9" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
