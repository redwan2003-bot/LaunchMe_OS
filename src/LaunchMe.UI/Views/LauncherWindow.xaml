<Window
    x:Class="LaunchMe.UI.Views.LauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:LaunchMe.UI.ViewModels"
    xmlns:spaces="using:LaunchMe.Contracts.Spaces"
    xmlns:workflows="using:LaunchMe.Contracts.Workflows"
    xmlns:theming="using:LaunchMe.UI.Theming"
    xmlns:wallpaper="using:LaunchMe.UI.Wallpaper"
    xmlns:widgets="using:LaunchMe.UI.Widgets.Catalog"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent" KeyDown="RootGrid_KeyDown">
        <!-- Live / Dynamic / Static Wallpaper layer -->
        <wallpaper:LiveWallpaperControl x:Name="WallpaperSurface"
                                        ViewModel="{x:Bind ViewModel.Wallpaper, Mode=OneWay}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch" />

        <!-- Liquid Glass Acrylic & Tint overlay / dismiss catcher -->
        <theming:LiquidGlassOverlayControl x:Name="LiquidGlassBackdrop"
                                           VisualState="{x:Bind ViewModel.ThemeVisualState, Mode=OneWay}"
                                           PointerPressed="DismissBackdrop_PointerPressed" />

        <Grid Margin="48,32,48,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Center: Unified Search Bar -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Width="680" Spacing="8">
                <Grid CornerRadius="12" Background="#D81F293D" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" Glyph="&#xE721;" Foreground="#94A3B8" Margin="4,0,8,0" FontSize="16" />

                    <TextBox x:Name="SearchBox"
                             Grid.Column="1"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             PlaceholderText="Search apps, files, math, or press TAB for Emoji..."
                             PlaceholderForeground="#64748B"
                             FontSize="16"
                             Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="SearchBox_PreviewKeyDown" />

                    <!-- Search / Emoji Mode Badge -->
                    <Border Grid.Column="2"
                            Background="#3338BDF8"
                            CornerRadius="6"
                            Padding="8,3"
                            Visibility="{x:Bind ViewModel.EmojiModeBadgeVisibility, Mode=OneWay}">
                        <TextBlock Text="EMOJI (TAB)" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <!-- Search Results Dropdown overlay -->
                <Border x:Name="SearchResultsPopup"
                        Background="#E6111827"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="12"
                        MaxHeight="380"
                        Visibility="{x:Bind ViewModel.SearchResultsVisibility, Mode=OneWay}">
                    <ListView x:Name="SearchResultsList"
                              ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                              SelectedIndex="{x:Bind ViewModel.SelectedSearchIndex, Mode=TwoWay}"
                              ItemClick="SearchResultsList_ItemClick"
                              IsItemClickEnabled="True">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:UnifiedSearchResultViewModel">
                                <Grid Padding="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind CategoryGlyph}" FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" Foreground="#38BDF8"/>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Foreground="White" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Subtitle}" Foreground="#94A3B8" FontSize="12" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind CategoryName}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>

            <!-- Main Content Area + Right-Side Widget Drawer -->
            <Grid Grid.Row="1" Margin="0,16,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Category Tabs Bar above App Grid -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Content="{x:Bind}"
                                        Tag="{x:Bind}"
                                        Click="CategoryButton_Click"
                                        Background="#26FFFFFF"
                                        Foreground="White"
                                        CornerRadius="14"
                                        Padding="12,5"
                                        FontSize="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Main Page Items Grid (Virtualized Multi-Page Carousel) -->
                <FlipView x:Name="LauncherFlipView"
                          Grid.Row="1"
                          Grid.Column="0"
                          ItemsSource="{x:Bind ViewModel.Pages, Mode=OneWay}"
                          SelectedIndex="{x:Bind ViewModel.CurrentPageIndex, Mode=TwoWay}">
                    <FlipView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LauncherPageViewModel">
                            <GridView ItemsSource="{x:Bind Items, Mode=OneWay}"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="LauncherGridView_ItemClick"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LauncherItemViewModel">
                                        <Grid Width="96" Height="110" Margin="12"
                                              Background="Transparent"
                                              CanDrag="{x:Bind IsEditModeActive, Mode=OneWay}"
                                              DragStarting="Item_DragStarting"
                                              Drop="Item_Drop"
                                              AllowDrop="True">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                                <Border Width="64" Height="64" CornerRadius="16" Background="#1F2937" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                    <Image Source="{x:Bind IconImageSource, Mode=OneWay}" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                           Foreground="White"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center"
                                                           Visibility="{x:Bind IsTitleVisible, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </DataTemplate>
                    </FlipView.ItemTemplate>
                </FlipView>

                <!-- Space Switcher & Workflow Quick-Launch Strip -->
                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="16"
                            Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{x:Bind ViewModel.SpacesBarVisibility, Mode=OneWay}">
                        <TextBlock Text="Space:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Spaces, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="spaces:SpaceModel">
                                    <Button Content="{x:Bind Name}"
                                            Tag="{x:Bind SpaceId}"
                                            Click="SpaceButton_Click"
                                            Background="#2638BDF8"
                                            Foreground="White"
                                            CornerRadius="8"
                                            Padding="10,4"
                                            FontSize="12" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{x:Bind ViewModel.WorkflowsStripVisibility, Mode=OneWay}">
                        <TextBlock Text="Workflows:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Workflows, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="workflows:WorkflowDefinition">
                                    <Button Content="{x:Bind Name}"
                                            Tag="{x:Bind}"
                                            Click="WorkflowButton_Click"
                                            Background="#3310B981"
                                            Foreground="White"
                                            CornerRadius="8"
                                            Padding="10,4"
                                            FontSize="12" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Right-Side Widget Catalog Drawer -->
                <Border Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="1"
                        Width="360"
                        Margin="16,0,0,0"
                        Background="#D80F172A"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="16"
                        Visibility="{x:Bind ViewModel.WidgetDrawerVisibility, Mode=OneWay}">
                    <widgets:WidgetCatalogView ViewModel="{x:Bind ViewModel.WidgetCatalog, Mode=OneWay}" />
                </Border>
            </Grid>

            <!-- Bottom Pagination Dots & Toolbar Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <!-- Page Switcher Dots -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.PageIndicators, Mode=OneWay}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PageIndicatorViewModel">
                            <Ellipse Width="8" Height="8"
                                     Fill="{x:Bind DotColor, Mode=OneWay}"
                                     PointerPressed="PageDot_PointerPressed"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Edit Mode Button -->
                <Button Content="{x:Bind ViewModel.EditModeButtonText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleEditModeCommand}"
                        Background="#33FFFFFF"
                        Foreground="White"
                        CornerRadius="8"
                        Padding="12,4" />

                <!-- Widgets Drawer Toggle Button -->
                <Button Content="Widgets"
                        Command="{x:Bind ViewModel.ToggleWidgetDrawerCommand}"
                        Background="#33FFFFFF"
                        Foreground="White"
                        CornerRadius="8"
                        Padding="12,4" />

                <!-- Settings & Diagnostics Toggle Button -->
                <Button Content="Settings"
                        Command="{x:Bind ViewModel.ToggleSettingsCommand}"
                        Background="#33FFFFFF"
                        Foreground="White"
                        CornerRadius="8"
                        Padding="12,4" />

                <!-- Exit App Button -->
                <Button Content="Exit"
                        Command="{x:Bind ViewModel.QuitAppCommand}"
                        Background="#44EF4444"
                        Foreground="White"
                        CornerRadius="8"
                        Padding="12,4" />
            </StackPanel>
        </Grid>

        <!-- Smart Folder Modal Overlay -->
        <Grid x:Name="FolderModalOverlay"
              Background="#80000000"
              Visibility="{x:Bind ViewModel.FolderModalVisibility, Mode=OneWay}"
              PointerPressed="FolderScrim_PointerPressed">
            <Border Width="540"
                    MaxHeight="460"
                    Background="#EC111827"
                    BorderBrush="#44FFFFFF"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    PointerPressed="ModalCard_PointerPressed">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="{x:Bind ViewModel.ActiveFolderName, Mode=OneWay}"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Content="Close"
                                Command="{x:Bind ViewModel.CloseFolderCommand}"
                                HorizontalAlignment="Right"
                                Background="#33FFFFFF"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="12,4" />
                    </Grid>

                    <GridView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.ActiveFolderChildren, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="FolderGridView_ItemClick">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:LauncherItemViewModel">
                                <Grid Width="92" Height="104" Margin="8" Background="Transparent">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                        <Border Width="56" Height="56" CornerRadius="14" Background="#1F2937" BorderBrush="#33FFFFFF" BorderThickness="1">
                                            <Image Source="{x:Bind IconImageSource, Mode=OneWay}" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </Border>
        </Grid>

        <!-- Settings & Diagnostics Flyout Overlay -->
        <Grid x:Name="SettingsOverlay"
              Background="#66000000"
              Visibility="{x:Bind ViewModel.SettingsOverlayVisibility, Mode=OneWay}"
              PointerPressed="SettingsScrim_PointerPressed">
            <Border Width="440"
                    Background="#F0111827"
                    BorderBrush="#44FFFFFF"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    PointerPressed="ModalCard_PointerPressed">
                <StackPanel Spacing="16">
                    <Grid>
                        <TextBlock Text="Settings &amp; Diagnostics"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Content="Close"
                                Command="{x:Bind ViewModel.ToggleSettingsCommand}"
                                HorizontalAlignment="Right"
                                Background="#33FFFFFF"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="10,4" />
                    </Grid>

                    <Border Background="#1FFFFFFF" CornerRadius="10" Padding="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Active Space" Foreground="#94A3B8" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveSpaceName, Mode=OneWay}" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.DiagnosticsSummary, Mode=OneWay}" Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.PlatformDiagnosticsText, Mode=OneWay}" Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Bind ViewModel.SchedulerStatusText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ToggleSchedulerCommand}"
                                Background="#33FFFFFF"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="10,6" />
                        <Button Content="{x:Bind ViewModel.ThemeAssociationStatusText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ToggleThemeAssociationCommand}"
                                Background="#33FFFFFF"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="10,6" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Quick Theme Tint" Foreground="#94A3B8" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Cobalt" Tag="#1E40AF" Click="QuickTintButton_Click" Background="#1E40AF" Foreground="White" CornerRadius="8" />
                            <Button Content="Emerald" Tag="#047857" Click="QuickTintButton_Click" Background="#047857" Foreground="White" CornerRadius="8" />
                            <Button Content="Crimson" Tag="#9F1239" Click="QuickTintButton_Click" Background="#9F1239" Foreground="White" CornerRadius="8" />
                            <Button Content="Slate" Tag="#1E293B" Click="QuickTintButton_Click" Background="#1E293B" Foreground="White" CornerRadius="8" />
                        </StackPanel>
                    </StackPanel>

                    <Button Content="Exit LaunchMe-Win"
                            Command="{x:Bind ViewModel.QuitAppCommand}"
                            HorizontalAlignment="Stretch"
                            Background="#CCDC2626"
                            Foreground="White"
                            CornerRadius="8"
                            Padding="12,8" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
