<Window
    x:Class="LaunchMe.UI.Views.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:LaunchMe.UI.ViewModels"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- Dock Glass Bar -->
        <Border CornerRadius="16"
                Background="#EE0F172A"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,8"
                Padding="16,8">

            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <!-- Dock Spaces Navigator -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Padding="4,2"
                            Command="{x:Bind ViewModel.PreviousSpaceCommand}" />
                    <TextBlock Text="{x:Bind ViewModel.ActiveDockSpaceName, Mode=OneWay}"
                               FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0" />
                    <Button Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Padding="4,2"
                            Command="{x:Bind ViewModel.NextSpaceCommand}" />
                </StackPanel>

                <Rectangle Width="1" Height="24" Fill="#33FFFFFF" />

                <!-- Dock Items Icons -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.DockItems, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="8">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE71D;" FontSize="18" Foreground="#38BDF8" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Rectangle Width="1" Height="24" Fill="#33FFFFFF" />

                <!-- Mini System Stats Widget -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.CpuUsage, Mode=OneWay}" FontSize="10" Foreground="#4ADE80" />
                    <TextBlock Text="{x:Bind ViewModel.RamUsage, Mode=OneWay}" FontSize="10" Foreground="#FBBF24" />
                    <TextBlock Text="{x:Bind ViewModel.NetUsage, Mode=OneWay}" FontSize="10" Foreground="#38BDF8" />
                </StackPanel>

                <Rectangle Width="1" Height="24" Fill="#33FFFFFF" />

                <!-- Ambient Sound Controller -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Padding="6,4" Background="Transparent" BorderThickness="0"
                            Command="{x:Bind ViewModel.ToggleAmbientSoundCommand}">
                        <FontIcon Glyph="&#xE93E;" FontSize="14" Foreground="#C084FC" />
                    </Button>
                    <Button Content="Preset" FontSize="10" Padding="6,2"
                            Command="{x:Bind ViewModel.CycleAmbientPresetCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
