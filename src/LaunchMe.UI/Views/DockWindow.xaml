<Window
    x:Class="LaunchMe.UI.Views.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:LaunchMe.UI.ViewModels"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent" UseLayoutRounding="False">
        <!-- Floating Capsule Dock -->
        <Border x:Name="DockCapsule"
                CornerRadius="26"
                Background="#E60B0F17"
                BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                BorderThickness="0.5"
                UseLayoutRounding="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,8"
                Padding="14,7">

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- Dock Spaces Navigator -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Content="&#xE76B;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11"
                            Padding="6,4"
                            CornerRadius="10"
                            Background="#14FFFFFF"
                            BorderBrush="{StaticResource SpecularInnerRimBrush}"
                            BorderThickness="0.5"
                            Command="{x:Bind ViewModel.PreviousSpaceCommand}" />
                    <TextBlock Text="{x:Bind ViewModel.ActiveDockSpaceName, Mode=OneWay}"
                               Style="{StaticResource EditorialMicroEyebrowStyle}"
                               Foreground="#FFE2E8F0"
                               VerticalAlignment="Center"
                               Margin="6,0" />
                    <Button Content="&#xE76C;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11"
                            Padding="6,4"
                            CornerRadius="10"
                            Background="#14FFFFFF"
                            BorderBrush="{StaticResource SpecularInnerRimBrush}"
                            BorderThickness="0.5"
                            Command="{x:Bind ViewModel.NextSpaceCommand}" />
                </StackPanel>

                <Rectangle Width="1" Height="24" Fill="#1FFFFFFF" />

                <!-- Dock Items Icons with Neighbor-Wave Gaussian Spring -->
                <ItemsControl x:Name="DockItemsControl"
                              ItemsSource="{x:Bind ViewModel.DockItems, Mode=OneWay}"
                              PointerMoved="DockItems_PointerMoved"
                              PointerExited="DockItems_PointerExited">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Background="#16161D2E"
                                    BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                    BorderThickness="0.5"
                                    UseLayoutRounding="False"
                                    Padding="8"
                                    CornerRadius="14"
                                    PointerEntered="DockItem_PointerEntered"
                                    PointerExited="DockItem_PointerExited">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE71D;" FontSize="18" Foreground="#FF00F0FF" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Rectangle Width="1" Height="24" Fill="#1FFFFFFF" />

                <!-- Touch Bar Quick-Action Tool Bar Strip -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.ToolBarActions, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DockToolBarAction">
                            <Button Tag="{x:Bind}"
                                    Click="ToolBarButton_Click"
                                    Padding="8,4"
                                    CornerRadius="10"
                                    Background="#1800F0FF"
                                    BorderBrush="#4400F0FF"
                                    BorderThickness="0.5">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="11" Foreground="#FF00F0FF" />
                                    <TextBlock Text="{x:Bind Label}" FontSize="10" FontWeight="SemiBold" Foreground="#FFE2E8F0" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Rectangle Width="1" Height="24" Fill="#1FFFFFFF" />

                <!-- Circular-Style Color-Coded Telemetry Pills (CPU / RAM / NET) -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border CornerRadius="12"
                            Padding="9,4"
                            Background="#1400FF9D"
                            BorderBrush="#5500FF9D"
                            BorderThickness="0.5"
                            UseLayoutRounding="False">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#FF00FF9D" />
                            <TextBlock Text="{x:Bind ViewModel.CpuUsage, Mode=OneWay}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#FF00FF9D" />
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12"
                            Padding="9,4"
                            Background="#14F59E0B"
                            BorderBrush="#55F59E0B"
                            BorderThickness="0.5"
                            UseLayoutRounding="False">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#FFF59E0B" />
                            <TextBlock Text="{x:Bind ViewModel.RamUsage, Mode=OneWay}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#FFF59E0B" />
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="12"
                            Padding="9,4"
                            Background="#1400F0FF"
                            BorderBrush="#5500F0FF"
                            BorderThickness="0.5"
                            UseLayoutRounding="False">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#FF00F0FF" />
                            <TextBlock Text="{x:Bind ViewModel.NetUsage, Mode=OneWay}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#FF00F0FF" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Rectangle Width="1" Height="24" Fill="#1FFFFFFF" />

                <!-- Leash & Soundscape Status Badges & Ambient Controller -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Style="{StaticResource EditorialMicroBadge}"
                            CornerRadius="12"
                            Background="#1400FF9D"
                            BorderBrush="#5500FF9D">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Ellipse Width="5" Height="5" Fill="#FF00FF9D" />
                            <TextBlock Text="LEASH"
                                       Style="{StaticResource EditorialMicroBadgeTextStyle}"
                                       Foreground="#FF00FF9D"
                                       FontSize="9" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource EditorialMicroBadge}"
                            CornerRadius="12"
                            Background="#1AA855F7"
                            BorderBrush="#55A855F7">
                        <TextBlock Text="SOUNDSCAPE"
                                   Style="{StaticResource EditorialMicroBadgeTextStyle}"
                                   Foreground="#FFA855F7"
                                   FontSize="9" />
                    </Border>

                    <Button Padding="6,4"
                            CornerRadius="10"
                            Background="#14A855F7"
                            BorderBrush="#44A855F7"
                            BorderThickness="0.5"
                            Command="{x:Bind ViewModel.ToggleAmbientSoundCommand}">
                        <FontIcon Glyph="&#xE93E;" FontSize="14" Foreground="#FFA855F7" />
                    </Button>

                    <Button Content="Preset"
                            FontSize="10"
                            Padding="8,3"
                            CornerRadius="10"
                            Background="#14FFFFFF"
                            BorderBrush="{StaticResource SpecularInnerRimBrush}"
                            BorderThickness="0.5"
                            Foreground="#FFE2E8F0"
                            Command="{x:Bind ViewModel.CycleAmbientPresetCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
