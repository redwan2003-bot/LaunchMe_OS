<Window
    x:Class="LaunchMe.UI.Views.NotchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:LaunchMe.UI.ViewModels"
    xmlns:clip="using:LaunchMe.Contracts.Clipboard"
    xmlns:notch="using:LaunchMe.Contracts.Notch"
    Title="Snoot HUD"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent" UseLayoutRounding="False">
        <!-- Snoot HUD Obsidian Glass Pill -->
        <Border x:Name="NotchContainer"
                CornerRadius="22"
                Background="#E8080A0F"
                BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                BorderThickness="0.5"
                UseLayoutRounding="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="{x:Bind ViewModel.WidthPx, Mode=OneWay}"
                Height="{x:Bind ViewModel.HeightPx, Mode=OneWay}"
                Padding="14,6"
                AllowDrop="True"
                DragOver="NotchContainer_DragOver"
                DragLeave="NotchContainer_DragLeave"
                Drop="NotchContainer_Drop">

            <Grid UseLayoutRounding="False">
                <!-- Compact Snoot HUD Row -->
                <Grid VerticalAlignment="Top" Height="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Glowing Status Indicator + Snoot HUD / Weather -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Grid Width="12" Height="12" VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12" Fill="#3300FF9D" />
                            <Ellipse Width="6" Height="6" Fill="#FF00FF9D" />
                        </Grid>
                        <TextBlock Text="SNOOT HUD"
                                   Style="{StaticResource EditorialMicroEyebrowStyle}"
                                   Foreground="#FF00F0FF"
                                   VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE753;" FontSize="12" Foreground="#FF00F0FF" />
                        <TextBlock Text="{x:Bind ViewModel.WeatherSummary, Mode=OneWay}"
                                   FontSize="11" Foreground="#FFE2E8F0" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Center Pill: Blobbo, Now Playing & Focus Timer -->
                    <Button Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,2"
                            Command="{x:Bind ViewModel.ToggleExpandCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.Blobbo.MoodEmoji, Mode=OneWay}"
                                       FontSize="11" Foreground="#FFA855F7" FontWeight="Bold" />
                            <TextBlock Text="{x:Bind ViewModel.NowPlayingTitle, Mode=OneWay}"
                                       Style="{StaticResource EditorialBentoHeaderStyle}"
                                       FontSize="11.5"
                                       MaxWidth="135"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="•" FontSize="10" Foreground="#FF64748B" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.TimerDisplay, Mode=OneWay}"
                                       Style="{StaticResource EditorialHeroMetricStyle}"
                                       FontSize="11.5"
                                       Foreground="#FFF59E0B"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Right Status: Bluetooth Toast + Focus Badge + Battery & Live Ring -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Background="#2400F0FF"
                                BorderBrush="#FF00F0FF"
                                BorderThickness="0.5"
                                CornerRadius="8"
                                Padding="6,1"
                                Visibility="{x:Bind ViewModel.BluetoothToastVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE702;" FontSize="9" Foreground="#FF00F0FF" />
                                <TextBlock Text="{x:Bind ViewModel.BluetoothToastText, Mode=OneWay}" FontSize="9" FontWeight="SemiBold" Foreground="#FFE2E8F0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#2EA855F7"
                                BorderBrush="#FFA855F7"
                                BorderThickness="0.5"
                                CornerRadius="8"
                                Padding="6,1"
                                Visibility="{x:Bind ViewModel.FocusModeVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE708;" FontSize="9" Foreground="#FFE9D5FF" />
                                <TextBlock Text="FOCUS" FontSize="9" FontWeight="Bold" Foreground="#FFE9D5FF" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.BatteryPercentage, Mode=OneWay}"
                                   FontSize="11" Foreground="#FF94A3B8" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xEA93;" FontSize="12" Foreground="#FF00FF9D" />
                    </StackPanel>
                </Grid>

                <!-- Expanded Snoot HUD Drawer -->
                <Grid Margin="0,36,0,0"
                      Visibility="{x:Bind ViewModel.ExpandedDrawerVisibility, Mode=OneWay}"
                      UseLayoutRounding="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Blobbo Companion, Focus Timer & Focus Mode Controls -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,2,0,8">
                        <Button Content="Poke"
                                FontSize="10.5"
                                Padding="9,3"
                                CornerRadius="10"
                                Background="#24A855F7"
                                BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                BorderThickness="0.5"
                                Foreground="#FFF8FAFC"
                                Command="{x:Bind ViewModel.Blobbo.PokeCommand}" />
                        <Button Content="Start 25m"
                                FontSize="10.5"
                                Padding="9,3"
                                CornerRadius="10"
                                Background="#1F00F0FF"
                                BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                BorderThickness="0.5"
                                Foreground="#FF00F0FF"
                                Command="{x:Bind ViewModel.StartTimerCommand}" />
                        <Button Content="Pause"
                                FontSize="10.5"
                                Padding="9,3"
                                CornerRadius="10"
                                Background="#1AFFFFFF"
                                BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                BorderThickness="0.5"
                                Foreground="#FFE2E8F0"
                                Command="{x:Bind ViewModel.PauseTimerCommand}" />
                        <Button Content="Reset"
                                FontSize="10.5"
                                Padding="9,3"
                                CornerRadius="10"
                                Background="#1AFFFFFF"
                                BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                BorderThickness="0.5"
                                Foreground="#FF94A3B8"
                                Command="{x:Bind ViewModel.ResetTimerCommand}" />
                        <Button FontSize="10.5"
                                Padding="9,3"
                                CornerRadius="10"
                                Background="#24A855F7"
                                BorderBrush="#FFA855F7"
                                BorderThickness="0.5"
                                Foreground="#FFE9D5FF"
                                Command="{x:Bind ViewModel.ToggleFocusModeCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE708;" FontSize="10" />
                                <TextBlock Text="{x:Bind ViewModel.FocusModeBadgeText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Row 1: Drawer Tab Switcher Pills -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,0,0,8">
                        <Button Content="Pocket &amp; Share"
                                FontSize="10.5"
                                FontWeight="SemiBold"
                                Padding="12,4"
                                CornerRadius="10"
                                Background="#1E293B"
                                BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                BorderThickness="0.5"
                                Foreground="#FFF8FAFC"
                                Command="{x:Bind ViewModel.SelectPocketTabCommand}" />
                        <Button Content="Clipboard"
                                FontSize="10.5"
                                FontWeight="SemiBold"
                                Padding="12,4"
                                CornerRadius="10"
                                Background="#1E293B"
                                BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                BorderThickness="0.5"
                                Foreground="#FF00F0FF"
                                Command="{x:Bind ViewModel.SelectClipboardTabCommand}" />
                        <Button Content="Size &amp; HUD"
                                FontSize="10.5"
                                FontWeight="SemiBold"
                                Padding="12,4"
                                CornerRadius="10"
                                Background="#1E293B"
                                BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                BorderThickness="0.5"
                                Foreground="#FFA855F7"
                                Command="{x:Bind ViewModel.SelectSettingsTabCommand}" />
                    </StackPanel>

                    <!-- Row 2: Active Drawer Body -->
                    <Grid Grid.Row="2" Margin="2,0">

                        <!-- 1) POCKET & PERMISSION TAB -->
                        <Border Background="#D90E131F"
                                BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                BorderThickness="0.5"
                                UseLayoutRounding="False"
                                CornerRadius="14"
                                Padding="10"
                                Visibility="{x:Bind ViewModel.PocketTabVisibility, Mode=OneWay}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Neon Pookie Permission Alert Card -->
                                <Border Grid.Row="0"
                                        Margin="0,0,0,8"
                                        Background="#E6161D2E"
                                        BorderBrush="{StaticResource SpecularPookieAlertBorderBrush}"
                                        BorderThickness="0.5"
                                        UseLayoutRounding="False"
                                        CornerRadius="12"
                                        Padding="10"
                                        Visibility="{x:Bind ViewModel.Approvals.ApprovalCardVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Grid Width="10" Height="10" VerticalAlignment="Center">
                                                <Ellipse Width="10" Height="10" Fill="#44F59E0B" />
                                                <Ellipse Width="5" Height="5" Fill="#FFF59E0B" />
                                            </Grid>
                                            <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="#FFF59E0B" />
                                            <TextBlock Text="Pookie Permission Alert"
                                                       Style="{StaticResource EditorialMicroEyebrowStyle}"
                                                       Foreground="#FFF59E0B" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.Approvals.ActiveRequest.CommandOrAction, Mode=OneWay}"
                                                   FontSize="10.5" Foreground="#FFF8FAFC" TextWrapping="Wrap" MaxHeight="40" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="Allow" FontSize="9.5" FontWeight="SemiBold" Padding="10,3" CornerRadius="8"
                                                    Background="#2600FF9D" BorderBrush="#FF00FF9D" BorderThickness="0.5" Foreground="#FF00FF9D"
                                                    Command="{x:Bind ViewModel.Approvals.ApproveCommand}" />
                                            <Button Content="Deny" FontSize="9.5" FontWeight="SemiBold" Padding="10,3" CornerRadius="8"
                                                    Background="#2AEF4444" BorderBrush="#FFEF4444" BorderThickness="0.5" Foreground="#FFFCA5A5"
                                                    Command="{x:Bind ViewModel.Approvals.DenyCommand}" />
                                            <Button Content="Always Allow" FontSize="9.5" Padding="10,3" CornerRadius="8"
                                                    Background="#1AA855F7" BorderBrush="#88A855F7" BorderThickness="0.5" Foreground="#FFE9D5FF"
                                                    Command="{x:Bind ViewModel.Approvals.RememberRuleCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Header + Clear + Share -->
                                <Grid Grid.Row="1" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="6">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="11" Foreground="#FFA855F7" />
                                        <TextBlock Text="Snoot Pocket Shelf"
                                                   Style="{StaticResource EditorialMicroEyebrowStyle}"
                                                   Foreground="#FFE2E8F0" />
                                        <Border Style="{StaticResource EditorialMicroBadge}" Padding="6,1" Background="#1AA855F7">
                                            <TextBlock Text="DROP FILES" Style="{StaticResource EditorialMicroBadgeTextStyle}" Foreground="#FFA855F7" FontSize="9" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                        <Button Content="Nearby Share" FontSize="9.5" Padding="8,2" CornerRadius="8"
                                                Background="#1F00F0FF" BorderBrush="#4400F0FF" BorderThickness="0.5" Foreground="#FF00F0FF"
                                                Click="NearbyShareButton_Click" />
                                        <Button Content="Clear" FontSize="9.5" Padding="8,2" CornerRadius="8"
                                                Background="#1AFFFFFF" BorderBrush="{StaticResource SpecularGlassChamferBrush}" BorderThickness="0.5" Foreground="#FF94A3B8"
                                                Command="{x:Bind ViewModel.ClearPocketCommand}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Snoot Pocket Items List -->
                                <ListView Grid.Row="2"
                                          ItemsSource="{x:Bind ViewModel.PocketItems, Mode=OneWay}"
                                          SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="notch:PocketItem">
                                            <Grid Padding="6,4" CornerRadius="8" Background="#14FFFFFF" Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="12" Foreground="#FFA855F7" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind FileName}" FontSize="11" Foreground="#FFF8FAFC" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="Ready" FontSize="9.5" Foreground="#FF00FF9D" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- 2) CLIPBOARD CARD UI TAB -->
                        <Border Background="#D90E131F"
                                BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                BorderThickness="0.5"
                                UseLayoutRounding="False"
                                CornerRadius="14"
                                Padding="10"
                                Visibility="{x:Bind ViewModel.ClipboardTabVisibility, Mode=OneWay}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Category Filter Chips -->
                                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button Content="All" Tag="Recent" FontSize="9.5" Padding="8,3" CornerRadius="8" Background="#2400F0FF" Foreground="#FF00F0FF" Click="ClipboardCategoryChip_Click" />
                                        <Button Content="Images" Tag="Images" FontSize="9.5" Padding="8,3" CornerRadius="8" Background="#1AFFFFFF" Foreground="#FFE2E8F0" Click="ClipboardCategoryChip_Click" />
                                        <Button Content="Colors" Tag="Colors" FontSize="9.5" Padding="8,3" CornerRadius="8" Background="#1AFFFFFF" Foreground="#FFE2E8F0" Click="ClipboardCategoryChip_Click" />
                                        <Button Content="Code" Tag="Code" FontSize="9.5" Padding="8,3" CornerRadius="8" Background="#1AFFFFFF" Foreground="#FFE2E8F0" Click="ClipboardCategoryChip_Click" />
                                        <Button Content="Text" Tag="Text" FontSize="9.5" Padding="8,3" CornerRadius="8" Background="#1AFFFFFF" Foreground="#FFE2E8F0" Click="ClipboardCategoryChip_Click" />
                                        <Button Content="Files" Tag="Files" FontSize="9.5" Padding="8,3" CornerRadius="8" Background="#1AFFFFFF" Foreground="#FFE2E8F0" Click="ClipboardCategoryChip_Click" />
                                        <Button Content="Favorites" Tag="Favorites" FontSize="9.5" Padding="8,3" CornerRadius="8" Background="#1AA855F7" Foreground="#FFE9D5FF" Click="ClipboardCategoryChip_Click" />
                                        <Button Content="Clear" FontSize="9.5" Padding="8,3" CornerRadius="8" Background="#1AEF4444" Foreground="#FFFCA5A5" Command="{x:Bind ViewModel.ClearClipboardCommand}" />
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Visual Clipboard Cards List -->
                                <ListView Grid.Row="1"
                                          ItemsSource="{x:Bind ViewModel.FilteredClipboardCards, Mode=OneWay}"
                                          SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="clip:ClipboardEntry">
                                            <Border Background="#181E293B"
                                                    BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                                    BorderThickness="0.5"
                                                    CornerRadius="10"
                                                    Padding="8,6"
                                                    Margin="0,2"
                                                    CanDrag="True"
                                                    DragStarting="ClipboardCard_DragStarting">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Border Background="#2400F0FF" CornerRadius="5" Padding="5,1">
                                                                <TextBlock Text="{x:Bind Category}" FontSize="9" FontWeight="Bold" Foreground="#FF00F0FF" />
                                                            </Border>
                                                            <Border Background="#1AA855F7" CornerRadius="5" Padding="5,1">
                                                                <TextBlock Text="DRAG" FontSize="8.5" FontWeight="Bold" Foreground="#FFE9D5FF" />
                                                            </Border>
                                                            <TextBlock Text="{x:Bind SourceProcessName}" FontSize="9" Foreground="#FF64748B" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind TextContent}"
                                                                   FontSize="10.5"
                                                                   Foreground="#FFF8FAFC"
                                                                   MaxLines="2"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <Button Content="★" Tag="{x:Bind Id}" FontSize="10" Padding="6,2" CornerRadius="6"
                                                                Background="#1AA855F7" Foreground="#FFE9D5FF" Click="ClipboardFavoriteButton_Click" />
                                                        <Button Content="Copy" Tag="{x:Bind}" FontSize="9.5" Padding="7,2" CornerRadius="6"
                                                                Background="#2400FF9D" Foreground="#FF00FF9D" Click="ClipboardCopyButton_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- 3) SIZE & HUD SETTINGS TAB -->
                        <Border Background="#D90E131F"
                                BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                BorderThickness="0.5"
                                UseLayoutRounding="False"
                                CornerRadius="14"
                                Padding="12"
                                Visibility="{x:Bind ViewModel.SettingsTabVisibility, Mode=OneWay}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <TextBlock Text="HUD DIMENSIONS &amp; FOCUS" Style="{StaticResource EditorialMicroEyebrowStyle}" Foreground="#FF00F0FF" VerticalAlignment="Center" />
                                        <Button Content="Reset Default" HorizontalAlignment="Right" FontSize="9.5" Padding="8,2" CornerRadius="8"
                                                Background="#1AFFFFFF" Foreground="#FFE2E8F0" Command="{x:Bind ViewModel.ResetDimensionsCommand}" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Compact Width" FontSize="10.5" Foreground="#FFE2E8F0" VerticalAlignment="Center" />
                                        <Slider Width="240" HorizontalAlignment="Right" Minimum="280" Maximum="540" StepFrequency="10"
                                                Value="{x:Bind ViewModel.CompactWidthPx, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Compact Height" FontSize="10.5" Foreground="#FFE2E8F0" VerticalAlignment="Center" />
                                        <Slider Width="240" HorizontalAlignment="Right" Minimum="28" Maximum="56" StepFrequency="2"
                                                Value="{x:Bind ViewModel.CompactHeightPx, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Drawer Width" FontSize="10.5" Foreground="#FFE2E8F0" VerticalAlignment="Center" />
                                        <Slider Width="240" HorizontalAlignment="Right" Minimum="440" Maximum="760" StepFrequency="10"
                                                Value="{x:Bind ViewModel.ExpandedWidthPx, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Drawer Height" FontSize="10.5" Foreground="#FFE2E8F0" VerticalAlignment="Center" />
                                        <Slider Width="240" HorizontalAlignment="Right" Minimum="280" Maximum="540" StepFrequency="10"
                                                Value="{x:Bind ViewModel.ExpandedHeightPx, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock Text="DRAWER WIDGETS (ORDER &amp; SIZE)" Style="{StaticResource EditorialMicroEyebrowStyle}" Foreground="#FFA855F7" Margin="0,6,0,0" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.DrawerWidgets, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:NotchDrawerWidget">
                                                <Grid Padding="6,3" Margin="0,2" CornerRadius="8" Background="#14FFFFFF">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind Title}" FontSize="10.5" Foreground="#FFF8FAFC" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                        <Button Content="{x:Bind Size, Mode=OneWay}" Tag="{x:Bind Id}" FontSize="9" Padding="6,2" CornerRadius="6"
                                                                Background="#24A855F7" Foreground="#FFE9D5FF" Click="DrawerWidgetSize_Click" />
                                                        <Button Content="↑" Tag="{x:Bind Id}" FontSize="9" Padding="5,2" CornerRadius="6"
                                                                Background="#1AFFFFFF" Foreground="#FFE2E8F0" Click="DrawerWidgetMoveUp_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- SPLIT DROP-ZONE OVERLAY (Pocket vs Windows Nearby Share) -->
                        <Grid Visibility="{x:Bind ViewModel.DropZoneVisibility, Mode=OneWay}"
                              Background="#E8060911"
                              CornerRadius="14"
                              Padding="10"
                              ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Pocket Shelf Drop Zone -->
                            <Border x:Name="PocketDropZone"
                                    Grid.Column="0"
                                    Background="#26A855F7"
                                    BorderBrush="#FFA855F7"
                                    BorderThickness="1.5"
                                    CornerRadius="12"
                                    AllowDrop="True"
                                    Drop="PocketDropZone_Drop">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="26" Foreground="#FFE9D5FF" />
                                    <TextBlock Text="DROP TO POCKET" Style="{StaticResource EditorialMicroEyebrowStyle}" Foreground="#FFE9D5FF" HorizontalAlignment="Center" />
                                    <TextBlock Text="Hold files on shelf" FontSize="10" Foreground="#FFCBD5E1" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Right: Windows Nearby Share Drop Zone -->
                            <Border x:Name="NearbyShareDropZone"
                                    Grid.Column="1"
                                    Background="#2400F0FF"
                                    BorderBrush="#FF00F0FF"
                                    BorderThickness="1.5"
                                    CornerRadius="12"
                                    AllowDrop="True"
                                    Drop="NearbyShareDropZone_Drop">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <FontIcon Glyph="&#xE72D;" FontSize="26" Foreground="#FF00F0FF" />
                                    <TextBlock Text="NEARBY SHARE" Style="{StaticResource EditorialMicroEyebrowStyle}" Foreground="#FF00F0FF" HorizontalAlignment="Center" />
                                    <TextBlock Text="Windows Share sheet" FontSize="10" Foreground="#FFCBD5E1" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Footer -->
                    <Button Grid.Row="3"
                            Content="Collapse Snoot HUD"
                            FontSize="10"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0"
                            Padding="14,3"
                            CornerRadius="10"
                            Background="#1AFFFFFF"
                            BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                            BorderThickness="0.5"
                            Foreground="#FF94A3B8"
                            Command="{x:Bind ViewModel.ToggleExpandCommand}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
