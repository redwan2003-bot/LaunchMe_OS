<Window
    x:Class="LaunchMe.UI.Views.NotchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:LaunchMe.UI.ViewModels"
    xmlns:clip="using:LaunchMe.Contracts.Clipboard"
    xmlns:notch="using:LaunchMe.Contracts.Notch"
    Title="Snoot HUD"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent" UseLayoutRounding="False">
        <!-- Snoot HUD Obsidian Glass Pill -->
        <Border x:Name="NotchContainer"
                CornerRadius="22"
                Background="#E8080A0F"
                BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                BorderThickness="0.5"
                UseLayoutRounding="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="{x:Bind ViewModel.WidthPx, Mode=OneWay}"
                Height="{x:Bind ViewModel.HeightPx, Mode=OneWay}"
                Padding="14,6"
                AllowDrop="True"
                DragOver="NotchContainer_DragOver"
                DragLeave="NotchContainer_DragLeave"
                Drop="NotchContainer_Drop">

            <Grid UseLayoutRounding="False">
                <!-- Compact Snoot HUD Row -->
                <Grid VerticalAlignment="Top" Height="36"
                      Visibility="{x:Bind ViewModel.CompactBarVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Glowing Status Indicator + Snoot HUD / Weather -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Grid Width="12" Height="12" VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12" Fill="#3300FF9D" />
                            <Ellipse Width="6" Height="6" Fill="#FF00FF9D" />
                        </Grid>
                        <TextBlock Text="SNOOT HUD"
                                   Style="{StaticResource EditorialMicroEyebrowStyle}"
                                   Foreground="#FF00F0FF"
                                   VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE753;" FontSize="12" Foreground="#FF00F0FF" />
                        <TextBlock Text="{x:Bind ViewModel.WeatherSummary, Mode=OneWay}"
                                   FontSize="11" Foreground="#FFE2E8F0" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Center Pill: Blobbo, Now Playing & Focus Timer -->
                    <Button Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,2"
                            Command="{x:Bind ViewModel.ToggleExpandCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.Blobbo.MoodEmoji, Mode=OneWay}"
                                       FontSize="11" Foreground="#FFA855F7" FontWeight="Bold" />
                            <TextBlock Text="{x:Bind ViewModel.NowPlayingTitle, Mode=OneWay}"
                                       Style="{StaticResource EditorialBentoHeaderStyle}"
                                       FontSize="11.5"
                                       MaxWidth="135"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="•" FontSize="10" Foreground="#FF64748B" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.TimerDisplay, Mode=OneWay}"
                                       Style="{StaticResource EditorialHeroMetricStyle}"
                                       FontSize="11.5"
                                       Foreground="#FFF59E0B"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Right Status: Bluetooth Toast + Focus Badge + Battery & Live Ring -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Background="#2400F0FF"
                                BorderBrush="#FF00F0FF"
                                BorderThickness="0.5"
                                CornerRadius="8"
                                Padding="6,1"
                                Visibility="{x:Bind ViewModel.BluetoothToastVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE702;" FontSize="9" Foreground="#FF00F0FF" />
                                <TextBlock Text="{x:Bind ViewModel.BluetoothToastText, Mode=OneWay}" FontSize="9" FontWeight="SemiBold" Foreground="#FFE2E8F0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#2EA855F7"
                                BorderBrush="#FFA855F7"
                                BorderThickness="0.5"
                                CornerRadius="8"
                                Padding="6,1"
                                Visibility="{x:Bind ViewModel.FocusModeVisibility, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE708;" FontSize="9" Foreground="#FFE9D5FF" />
                                <TextBlock Text="FOCUS" FontSize="9" FontWeight="Bold" Foreground="#FFE9D5FF" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.BatteryPercentage, Mode=OneWay}"
                                   FontSize="11" Foreground="#FF94A3B8" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xEA93;" FontSize="12" Foreground="#FF00FF9D" />
                    </StackPanel>
                </Grid>

                <!-- Expanded Snoot HUD Drawer -->
                <Grid Margin="0,4,0,4"
                      Visibility="{x:Bind ViewModel.ExpandedDrawerVisibility, Mode=OneWay}"
                      UseLayoutRounding="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Top Navigation Icon Bar (Matching reference overview.png / chat.png / drop.png) -->
                    <Grid Grid.Row="0" Margin="4,0,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Navigation Pills -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <!-- Home / Overview -->
                            <Button Command="{x:Bind ViewModel.SelectOverviewTabCommand}"
                                    Width="30" Height="26" Padding="0" CornerRadius="13"
                                    Background="{x:Bind ViewModel.OverviewTabSelectedBrush, Mode=OneWay}"
                                    BorderThickness="0" ToolTipService.ToolTip="Overview">
                                <FontIcon Glyph="&#xE80F;" FontSize="12" Foreground="#FFF8FAFC" />
                            </Button>
                            <!-- Chat Bubble -->
                            <Button Command="{x:Bind ViewModel.SelectChatTabCommand}"
                                    Width="30" Height="26" Padding="0" CornerRadius="13"
                                    Background="{x:Bind ViewModel.ChatTabSelectedBrush, Mode=OneWay}"
                                    BorderThickness="0" ToolTipService.ToolTip="Chat">
                                <FontIcon Glyph="&#xE8BD;" FontSize="12" Foreground="#FFF8FAFC" />
                            </Button>
                            <!-- Drop Shelf (+) -->
                            <Button Command="{x:Bind ViewModel.SelectPocketTabCommand}"
                                    Width="30" Height="26" Padding="0" CornerRadius="13"
                                    Background="{x:Bind ViewModel.PocketTabSelectedBrush, Mode=OneWay}"
                                    BorderThickness="0" ToolTipService.ToolTip="Drop Shelf">
                                <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="#FFF8FAFC" />
                            </Button>
                            <!-- Clipboard History -->
                            <Button Command="{x:Bind ViewModel.SelectClipboardTabCommand}"
                                    Width="30" Height="26" Padding="0" CornerRadius="13"
                                    Background="{x:Bind ViewModel.ClipboardTabSelectedBrush, Mode=OneWay}"
                                    BorderThickness="0" ToolTipService.ToolTip="Clipboard History">
                                <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="#FF94A3B8" />
                            </Button>
                        </StackPanel>

                        <!-- Center: Blobbo Mood & Focus Timer Indicator -->
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.Blobbo.PokeCommand}"
                                Background="Transparent" BorderThickness="0" Padding="8,2"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.Blobbo.MoodEmoji, Mode=OneWay}" FontSize="11" Foreground="#FFF8FAFC" VerticalAlignment="Center" />
                                <TextBlock Text="•" FontSize="9" Foreground="#FF64748B" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.TimerDisplay, Mode=OneWay}" FontSize="11" Foreground="#FFF59E0B" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Right: Status Dot, Soundscape, Settings, Collapse -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#FF00FF9D" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Button Command="{x:Bind ViewModel.ToggleSoundscapeCommand}"
                                    Width="26" Height="26" Padding="0" CornerRadius="13"
                                    Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Soundscape">
                                <FontIcon Glyph="&#xE767;" FontSize="12" Foreground="#FF94A3B8" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.SelectSettingsTabCommand}"
                                    Width="26" Height="26" Padding="0" CornerRadius="13"
                                    Background="{x:Bind ViewModel.SettingsTabSelectedBrush, Mode=OneWay}"
                                    BorderThickness="0" ToolTipService.ToolTip="Settings">
                                <FontIcon Glyph="&#xE713;" FontSize="12" Foreground="#FF94A3B8" />
                            </Button>
                            <Button Command="{x:Bind ViewModel.ToggleExpandCommand}"
                                    Width="26" Height="26" Padding="0" CornerRadius="13"
                                    Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Collapse">
                                <FontIcon Glyph="&#xE70E;" FontSize="10" Foreground="#FF64748B" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Active Drawer Body -->
                    <Grid Grid.Row="1" Margin="2,0">

                        <!-- APPROVAL COCKPIT OVERLAY (Exact match to approval.png) -->
                        <Border Visibility="{x:Bind ViewModel.Approvals.ApprovalCardVisibility, Mode=OneWay}"
                                Canvas.ZIndex="10"
                                Background="#15171E" BorderBrush="#252A36" BorderThickness="1" CornerRadius="16" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Cute Blobbo Squircle Face with Warm Amber Glow & Alert Badge -->
                                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Ellipse Width="68" Height="68" Fill="#28F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Width="56" Height="44" CornerRadius="20" Background="#FFF8FAFC" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="0,2,0,0">
                                            <Ellipse Width="6" Height="8" Fill="#FF080A0F" />
                                            <Ellipse Width="6" Height="8" Fill="#FF080A0F" />
                                        </StackPanel>
                                    </Border>
                                    <Border Width="18" Height="18" CornerRadius="9" Background="#FFF59E0B" BorderBrush="#FF080A0F" BorderThickness="1.5"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-2,-2,0,0">
                                        <TextBlock Text="!" FontSize="11" FontWeight="Bold" Foreground="#FF080A0F" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                    </Border>
                                </Grid>

                                <!-- Right: Action & Buttons -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="6" Height="6" Fill="#FFF8FAFC" VerticalAlignment="Center" />
                                        <TextBlock FontSize="12">
                                            <Run Text="LaunchMe" FontWeight="Bold" Foreground="#FFF8FAFC" />
                                            <Run Text=" needs permission" FontWeight="Normal" Foreground="#94A3B8" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Background="#1C2029" BorderBrush="#2F3646" BorderThickness="1" CornerRadius="12" Padding="12,5">
                                        <TextBlock Text="{x:Bind ViewModel.Approvals.ActiveRequest.CommandOrAction, Mode=OneWay}"
                                                   FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="#FFF8FAFC" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Deny  N" Command="{x:Bind ViewModel.Approvals.DenyCommand}"
                                                Background="#282F3D" BorderThickness="0" CornerRadius="12" Padding="12,4"
                                                FontSize="11" Foreground="#FFF8FAFC" />
                                        <Button Content="Allow  Y" Command="{x:Bind ViewModel.Approvals.ApproveCommand}"
                                                Background="#FFF8FAFC" BorderThickness="0" CornerRadius="12" Padding="16,4"
                                                FontSize="11" FontWeight="Bold" Foreground="#FF080A0F" />
                                        <Button Content="Always" Command="{x:Bind ViewModel.Approvals.RememberRuleCommand}"
                                                Background="#282F3D" BorderThickness="0" CornerRadius="12" Padding="12,4"
                                                FontSize="11" Foreground="#FFF8FAFC" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 0) OVERVIEW TAB (Exact parity with macOS Reference overview.png) -->
                        <Grid Visibility="{x:Bind ViewModel.OverviewTabVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Bento Card: Antigravity IDE Integration & Live Running Task -->
                            <Border Grid.Column="0" Margin="0,0,5,0" Background="#141720" BorderBrush="#252A36" BorderThickness="1" CornerRadius="18" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Blobbo Cute Squircle Face -->
                                    <Border Grid.Column="0" Width="56" Height="42" CornerRadius="20" Background="#FFF8FAFC" VerticalAlignment="Center" Margin="0,0,12,0"
                                            Tapped="BlobboFace_Tapped" ToolTipService.ToolTip="Poke Blobbo">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="0,2,0,0">
                                            <Ellipse Width="5.5" Height="7.5" Fill="#FF0A0D14" />
                                            <Ellipse Width="5.5" Height="7.5" Fill="#FF0A0D14" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Task Info & Actions -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="6" Height="6" Fill="#FFF8FAFC" VerticalAlignment="Center" />
                                            <TextBlock FontSize="12.5" VerticalAlignment="Center">
                                                <Run Text="Antigravity" FontWeight="Bold" Foreground="#FFF8FAFC" />
                                                <Run Text=" Integration" FontWeight="Normal" Foreground="#94A3B8" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                            <Ellipse Width="5" Height="5" Fill="#FF10B981" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind ViewModel.AntigravityStatusText, Mode=OneWay}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                                            <Button Content="Open Antigravity" Command="{x:Bind ViewModel.OpenAntigravityCommand}"
                                                    Background="Transparent" BorderThickness="0" Padding="0"
                                                    FontSize="12" FontWeight="SemiBold" Foreground="#FFF8FAFC"
                                                    ToolTipService.ToolTip="Open &amp; Focus Antigravity IDE" />
                                            <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshAntigravityCommand}"
                                                    Background="Transparent" BorderThickness="0" Padding="0"
                                                    FontSize="12" Foreground="#64748B"
                                                    ToolTipService.ToolTip="Refresh live task &amp; process state" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Top-Right ↗ Arrow Button -->
                                    <Button Grid.Column="2" Command="{x:Bind ViewModel.OpenAntigravityCommand}"
                                            Width="22" Height="22" Padding="0" CornerRadius="11"
                                            Background="#222733" BorderThickness="0" VerticalAlignment="Top"
                                            ToolTipService.ToolTip="Focus Antigravity IDE">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="10" Foreground="#CBD5E1" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Right Bento Card: 4 AI Desktop App Pills (Exact match to overview.png) -->
                            <Border Grid.Column="1" Margin="5,0,0,0" Background="#141720" BorderBrush="#252A36" BorderThickness="1" CornerRadius="18" Padding="12,10">
                                <Grid RowSpacing="8" ColumnSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. Antigravity (Mint Green Squircle Character Face) -->
                                    <Button Grid.Row="0" Grid.Column="0" Command="{x:Bind ViewModel.LaunchAiAppCommand}" CommandParameter="Antigravity"
                                            PointerEntered="AiAppPill_PointerEntered" PointerExited="AiAppPill_PointerExited"
                                            ToolTipService.ToolTip="Launch &amp; Focus Antigravity"
                                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Margin="0"
                                            CornerRadius="19"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                        <Border Height="38" CornerRadius="19" Background="#0E1219" BorderBrush="#1A3B2B" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="34" Height="26" CornerRadius="13" Background="#10B981" Margin="5,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Margin="0,1,0,0">
                                                        <Ellipse Width="4" Height="5.5" Fill="#FF0A0D14" />
                                                        <Ellipse Width="4" Height="5.5" Fill="#FF0A0D14" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Antigravity" FontSize="11.5" FontWeight="Normal" Foreground="#CBD5E1"
                                                           VerticalAlignment="Center" Margin="8,0,6,0" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <!-- 2. Claude (Warm Orange Squircle Character Face) -->
                                    <Button Grid.Row="0" Grid.Column="1" Command="{x:Bind ViewModel.LaunchAiAppCommand}" CommandParameter="Claude Desktop"
                                            PointerEntered="AiAppPill_PointerEntered" PointerExited="AiAppPill_PointerExited"
                                            ToolTipService.ToolTip="Launch &amp; Focus Claude Desktop"
                                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Margin="0"
                                            CornerRadius="19"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                        <Border Height="38" CornerRadius="19" Background="#0E1219" BorderBrush="#3B2818" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="34" Height="26" CornerRadius="13" Background="#F97316" Margin="5,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Margin="0,1,0,0">
                                                        <Ellipse Width="4" Height="5.5" Fill="#FF0A0D14" />
                                                        <Ellipse Width="4" Height="5.5" Fill="#FF0A0D14" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Claude" FontSize="11.5" FontWeight="Normal" Foreground="#CBD5E1"
                                                           VerticalAlignment="Center" Margin="8,0,6,0" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <!-- 3. ChatGPT (Purple / Violet Squircle Character Face) -->
                                    <Button Grid.Row="1" Grid.Column="0" Command="{x:Bind ViewModel.LaunchAiAppCommand}" CommandParameter="ChatGPT Desktop"
                                            PointerEntered="AiAppPill_PointerEntered" PointerExited="AiAppPill_PointerExited"
                                            ToolTipService.ToolTip="Launch &amp; Focus ChatGPT Desktop"
                                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Margin="0"
                                            CornerRadius="19"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                        <Border Height="38" CornerRadius="19" Background="#0E1219" BorderBrush="#281E3D" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="34" Height="26" CornerRadius="13" Background="#8B5CF6" Margin="5,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Margin="0,1,0,0">
                                                        <Ellipse Width="4" Height="5.5" Fill="#FF0A0D14" />
                                                        <Ellipse Width="4" Height="5.5" Fill="#FF0A0D14" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="ChatGPT" FontSize="11.5" FontWeight="Normal" Foreground="#CBD5E1"
                                                           VerticalAlignment="Center" Margin="8,0,6,0" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <!-- 4. Gemini (Coral / Ruby Squircle Character Face) -->
                                    <Button Grid.Row="1" Grid.Column="1" Command="{x:Bind ViewModel.LaunchAiAppCommand}" CommandParameter="Gemini Desktop"
                                            PointerEntered="AiAppPill_PointerEntered" PointerExited="AiAppPill_PointerExited"
                                            ToolTipService.ToolTip="Launch &amp; Focus Gemini Desktop"
                                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Margin="0"
                                            CornerRadius="19"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                        <Border Height="38" CornerRadius="19" Background="#0E1219" BorderBrush="#3D1B24" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="34" Height="26" CornerRadius="13" Background="#F43F5E" Margin="5,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Margin="0,1,0,0">
                                                        <Ellipse Width="4" Height="5.5" Fill="#FF0A0D14" />
                                                        <Ellipse Width="4" Height="5.5" Fill="#FF0A0D14" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Gemini" FontSize="11.5" FontWeight="Normal" Foreground="#CBD5E1"
                                                           VerticalAlignment="Center" Margin="8,0,6,0" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 0B) CHAT TAB (Blobbo Character + Prompt Bar + Up-Arrow Submit) -->
                        <Border Visibility="{x:Bind ViewModel.ChatTabVisibility, Mode=OneWay}"
                                Background="#121622" BorderBrush="{StaticResource SpecularGlassChamferBrush}" BorderThickness="0.5" CornerRadius="16" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Blobbo Face -->
                                <Border Grid.Column="0" Width="52" Height="42" CornerRadius="20" Background="#FFF8FAFC" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="0,2,0,0">
                                        <Ellipse Width="6" Height="8" Fill="#FF080A0F" />
                                        <Ellipse Width="6" Height="8" Fill="#FF080A0F" />
                                    </StackPanel>
                                </Border>
                                <!-- Chat Prompt Capsule -->
                                <Border Grid.Column="1" Margin="12,0,0,0" Background="#1C2436" CornerRadius="18" Padding="12,4" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{x:Bind ViewModel.ChatQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Ask Blobbo or run command..."
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="#FFF8FAFC"
                                                 FontSize="12" />
                                        <Button Grid.Column="1"
                                                Command="{x:Bind ViewModel.SendChatCommand}"
                                                Width="28" Height="28"
                                                CornerRadius="14"
                                                Background="White"
                                                Foreground="#FF080A0F"
                                                Padding="0"
                                                HorizontalAlignment="Right">
                                            <FontIcon Glyph="&#xE74A;" FontSize="11" Foreground="#FF080A0F" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 1) POCKET & DROP SHELF TAB (Matching drop.png) -->
                        <Border Background="#15171E"
                                BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                BorderThickness="0.5"
                                UseLayoutRounding="False"
                                CornerRadius="16"
                                Padding="12,10"
                                Visibility="{x:Bind ViewModel.PocketTabVisibility, Mode=OneWay}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Drop Shelf (Drop files here + PDF, Images, Code, Docs) -->
                                <Border Grid.Row="0" Margin="0,0,0,6" Background="#121622" BorderBrush="#3B4252" BorderThickness="1" CornerRadius="14" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Blobbo Face -->
                                        <Border Grid.Column="0" Width="52" Height="42" CornerRadius="20" Background="#FFF8FAFC" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="0,2,0,0">
                                                <Ellipse Width="6" Height="8" Fill="#FF080A0F" />
                                                <Ellipse Width="6" Height="8" Fill="#FF080A0F" />
                                            </StackPanel>
                                        </Border>
                                        <!-- Drop Heading & Tag Pills -->
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="5">
                                            <TextBlock Text="Drop your files here" FontSize="13" FontWeight="Bold" Foreground="#FFF8FAFC" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Background="#262D3A" CornerRadius="10" Padding="10,4">
                                                    <TextBlock Text="PDF" FontSize="11" Foreground="#FFCBD5E1" />
                                                </Border>
                                                <Border Background="#262D3A" CornerRadius="10" Padding="10,4">
                                                    <TextBlock Text="Images" FontSize="11" Foreground="#FFCBD5E1" />
                                                </Border>
                                                <Border Background="#262D3A" CornerRadius="10" Padding="10,4">
                                                    <TextBlock Text="Code" FontSize="11" Foreground="#FFCBD5E1" />
                                                </Border>
                                                <Border Background="#262D3A" CornerRadius="10" Padding="10,4">
                                                    <TextBlock Text="Docs" FontSize="11" Foreground="#FFCBD5E1" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- Share / Clear -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Content="Share" FontSize="10" Padding="8,3" CornerRadius="8"
                                                    Background="#1F00F0FF" BorderBrush="#4400F0FF" BorderThickness="0.5" Foreground="#FF00F0FF"
                                                    Click="NearbyShareButton_Click" />
                                            <Button Content="Clear" FontSize="10" Padding="8,3" CornerRadius="8"
                                                    Background="#1AFFFFFF" BorderBrush="{StaticResource SpecularGlassChamferBrush}" BorderThickness="0.5" Foreground="#FF94A3B8"
                                                    Command="{x:Bind ViewModel.ClearPocketCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Snoot Pocket Items List -->
                                <ListView Grid.Row="1"
                                          ItemsSource="{x:Bind ViewModel.PocketItems, Mode=OneWay}"
                                          SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="notch:PocketItem">
                                            <Grid Padding="6,4" CornerRadius="8" Background="#14FFFFFF" Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="12" Foreground="#FFA855F7" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind FileName}" FontSize="11" Foreground="#FFF8FAFC" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="Ready" FontSize="9.5" Foreground="#FF00FF9D" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- 2) CLIPBOARD CARD UI TAB -->
                        <Border Background="#D90E131F"
                                BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                BorderThickness="0.5"
                                UseLayoutRounding="False"
                                CornerRadius="14"
                                Padding="10"
                                Visibility="{x:Bind ViewModel.ClipboardTabVisibility, Mode=OneWay}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Category Filter Chips -->
                                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Button Content="All" Tag="Recent" FontSize="9.5" Padding="8,3" CornerRadius="8" Background="#2400F0FF" Foreground="#FF00F0FF" Click="ClipboardCategoryChip_Click" />
                                        <Button Content="Images" Tag="Images" FontSize="9.5" Padding="8,3" CornerRadius="8" Background="#1AFFFFFF" Foreground="#FFE2E8F0" Click="ClipboardCategoryChip_Click" />
                                        <Button Content="Colors" Tag="Colors" FontSize="9.5" Padding="8,3" CornerRadius="8" Background="#1AFFFFFF" Foreground="#FFE2E8F0" Click="ClipboardCategoryChip_Click" />
                                        <Button Content="Code" Tag="Code" FontSize="9.5" Padding="8,3" CornerRadius="8" Background="#1AFFFFFF" Foreground="#FFE2E8F0" Click="ClipboardCategoryChip_Click" />
                                        <Button Content="Text" Tag="Text" FontSize="9.5" Padding="8,3" CornerRadius="8" Background="#1AFFFFFF" Foreground="#FFE2E8F0" Click="ClipboardCategoryChip_Click" />
                                        <Button Content="Files" Tag="Files" FontSize="9.5" Padding="8,3" CornerRadius="8" Background="#1AFFFFFF" Foreground="#FFE2E8F0" Click="ClipboardCategoryChip_Click" />
                                        <Button Content="Favorites" Tag="Favorites" FontSize="9.5" Padding="8,3" CornerRadius="8" Background="#1AA855F7" Foreground="#FFE9D5FF" Click="ClipboardCategoryChip_Click" />
                                        <Button Content="Clear" FontSize="9.5" Padding="8,3" CornerRadius="8" Background="#1AEF4444" Foreground="#FFFCA5A5" Command="{x:Bind ViewModel.ClearClipboardCommand}" />
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Visual Clipboard Cards List -->
                                <ListView Grid.Row="1"
                                          ItemsSource="{x:Bind ViewModel.FilteredClipboardCards, Mode=OneWay}"
                                          SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="clip:ClipboardEntry">
                                            <Border Background="#181E293B"
                                                    BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                                    BorderThickness="0.5"
                                                    CornerRadius="10"
                                                    Padding="8,6"
                                                    Margin="0,2"
                                                    CanDrag="True"
                                                    DragStarting="ClipboardCard_DragStarting">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <Border Background="#2400F0FF" CornerRadius="5" Padding="5,1">
                                                                <TextBlock Text="{x:Bind Category}" FontSize="9" FontWeight="Bold" Foreground="#FF00F0FF" />
                                                            </Border>
                                                            <Border Background="#1AA855F7" CornerRadius="5" Padding="5,1">
                                                                <TextBlock Text="DRAG" FontSize="8.5" FontWeight="Bold" Foreground="#FFE9D5FF" />
                                                            </Border>
                                                            <TextBlock Text="{x:Bind SourceProcessName}" FontSize="9" Foreground="#FF64748B" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind TextContent}"
                                                                   FontSize="10.5"
                                                                   Foreground="#FFF8FAFC"
                                                                   MaxLines="2"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <Button Content="★" Tag="{x:Bind Id}" FontSize="10" Padding="6,2" CornerRadius="6"
                                                                Background="#1AA855F7" Foreground="#FFE9D5FF" Click="ClipboardFavoriteButton_Click" />
                                                        <Button Content="Copy" Tag="{x:Bind}" FontSize="9.5" Padding="7,2" CornerRadius="6"
                                                                Background="#2400FF9D" Foreground="#FF00FF9D" Click="ClipboardCopyButton_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- 3) SIZE & HUD SETTINGS TAB -->
                        <Border Background="#D90E131F"
                                BorderBrush="{StaticResource SpecularGlassChamferBrush}"
                                BorderThickness="0.5"
                                UseLayoutRounding="False"
                                CornerRadius="14"
                                Padding="12"
                                Visibility="{x:Bind ViewModel.SettingsTabVisibility, Mode=OneWay}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <TextBlock Text="HUD DIMENSIONS &amp; FOCUS" Style="{StaticResource EditorialMicroEyebrowStyle}" Foreground="#FF00F0FF" VerticalAlignment="Center" />
                                        <Button Content="Reset Default" HorizontalAlignment="Right" FontSize="9.5" Padding="8,2" CornerRadius="8"
                                                Background="#1AFFFFFF" Foreground="#FFE2E8F0" Command="{x:Bind ViewModel.ResetDimensionsCommand}" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Compact Width" FontSize="10.5" Foreground="#FFE2E8F0" VerticalAlignment="Center" />
                                        <Slider Width="240" HorizontalAlignment="Right" Minimum="280" Maximum="540" StepFrequency="10"
                                                Value="{x:Bind ViewModel.CompactWidthPx, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Compact Height" FontSize="10.5" Foreground="#FFE2E8F0" VerticalAlignment="Center" />
                                        <Slider Width="240" HorizontalAlignment="Right" Minimum="28" Maximum="56" StepFrequency="2"
                                                Value="{x:Bind ViewModel.CompactHeightPx, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Drawer Width" FontSize="10.5" Foreground="#FFE2E8F0" VerticalAlignment="Center" />
                                        <Slider Width="240" HorizontalAlignment="Right" Minimum="440" Maximum="760" StepFrequency="10"
                                                Value="{x:Bind ViewModel.ExpandedWidthPx, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Drawer Height" FontSize="10.5" Foreground="#FFE2E8F0" VerticalAlignment="Center" />
                                        <Slider Width="240" HorizontalAlignment="Right" Minimum="280" Maximum="540" StepFrequency="10"
                                                Value="{x:Bind ViewModel.ExpandedHeightPx, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock Text="DRAWER WIDGETS (ORDER &amp; SIZE)" Style="{StaticResource EditorialMicroEyebrowStyle}" Foreground="#FFA855F7" Margin="0,6,0,0" />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.DrawerWidgets, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:NotchDrawerWidget">
                                                <Grid Padding="6,3" Margin="0,2" CornerRadius="8" Background="#14FFFFFF">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind Title}" FontSize="10.5" Foreground="#FFF8FAFC" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                        <Button Content="{x:Bind Size, Mode=OneWay}" Tag="{x:Bind Id}" FontSize="9" Padding="6,2" CornerRadius="6"
                                                                Background="#24A855F7" Foreground="#FFE9D5FF" Click="DrawerWidgetSize_Click" />
                                                        <Button Content="↑" Tag="{x:Bind Id}" FontSize="9" Padding="5,2" CornerRadius="6"
                                                                Background="#1AFFFFFF" Foreground="#FFE2E8F0" Click="DrawerWidgetMoveUp_Click" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- SPLIT DROP-ZONE OVERLAY (Pocket vs Windows Nearby Share) -->
                        <Grid Visibility="{x:Bind ViewModel.DropZoneVisibility, Mode=OneWay}"
                              Background="#E8060911"
                              CornerRadius="14"
                              Padding="10"
                              ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Pocket Shelf Drop Zone -->
                            <Border x:Name="PocketDropZone"
                                    Grid.Column="0"
                                    Background="#26A855F7"
                                    BorderBrush="#FFA855F7"
                                    BorderThickness="1.5"
                                    CornerRadius="12"
                                    AllowDrop="True"
                                    Drop="PocketDropZone_Drop">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="26" Foreground="#FFE9D5FF" />
                                    <TextBlock Text="DROP TO POCKET" Style="{StaticResource EditorialMicroEyebrowStyle}" Foreground="#FFE9D5FF" HorizontalAlignment="Center" />
                                    <TextBlock Text="Hold files on shelf" FontSize="10" Foreground="#FFCBD5E1" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Right: Windows Nearby Share Drop Zone -->
                            <Border x:Name="NearbyShareDropZone"
                                    Grid.Column="1"
                                    Background="#2400F0FF"
                                    BorderBrush="#FF00F0FF"
                                    BorderThickness="1.5"
                                    CornerRadius="12"
                                    AllowDrop="True"
                                    Drop="NearbyShareDropZone_Drop">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <FontIcon Glyph="&#xE72D;" FontSize="26" Foreground="#FF00F0FF" />
                                    <TextBlock Text="NEARBY SHARE" Style="{StaticResource EditorialMicroEyebrowStyle}" Foreground="#FF00F0FF" HorizontalAlignment="Center" />
                                    <TextBlock Text="Windows Share sheet" FontSize="10" Foreground="#FFCBD5E1" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
