<Window
    x:Class="LaunchMe.UI.Views.NotchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:LaunchMe.UI.ViewModels"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- Dynamic Notch Container -->
        <Border CornerRadius="18"
                Background="#EE0F172A"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="{x:Bind ViewModel.WidthPx, Mode=OneWay}"
                Height="{x:Bind ViewModel.HeightPx, Mode=OneWay}"
                Padding="12,6">

            <Grid>
                <!-- Compact HUD Row -->
                <Grid VerticalAlignment="Top" Height="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Weather / Focus Indicator -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE753;" FontSize="13" Foreground="#38BDF8" />
                        <TextBlock Text="{x:Bind ViewModel.WeatherSummary, Mode=OneWay}"
                                   FontSize="11" Foreground="#E2E8F0" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Center Pill: Now Playing, Mochi & Timer -->
                    <Button Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,2"
                            Command="{x:Bind ViewModel.ToggleExpandCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.Mochi.MoodEmoji, Mode=OneWay}"
                                       FontSize="11" Foreground="#FB7185" FontWeight="Bold" />
                            <TextBlock Text="{x:Bind ViewModel.NowPlayingTitle, Mode=OneWay}"
                                       FontSize="11" Foreground="White" FontWeight="Bold" MaxWidth="140" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="•" FontSize="10" Foreground="#64748B" />
                            <TextBlock Text="{x:Bind ViewModel.TimerDisplay, Mode=OneWay}"
                                       FontSize="11" Foreground="#FBBF24" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Right Status: Battery & Expand Toggle -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.BatteryPercentage, Mode=OneWay}"
                                   FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xEA93;" FontSize="12" Foreground="#4ADE80" />
                    </StackPanel>
                </Grid>

                <!-- Expanded Drawer Content -->
                <Grid Margin="0,36,0,0"
                      Visibility="{x:Bind ViewModel.ExpandedDrawerVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Pomodoro Controls & Mochi Mood -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,4,0,8">
                        <Button Content="Poke Mochi" FontSize="11" Padding="8,4" Command="{x:Bind ViewModel.Mochi.PokeCommand}" />
                        <Button Content="Start 25m" FontSize="11" Padding="8,4" Command="{x:Bind ViewModel.StartTimerCommand}" />
                        <Button Content="Pause" FontSize="11" Padding="8,4" Command="{x:Bind ViewModel.PauseTimerCommand}" />
                        <Button Content="Reset" FontSize="11" Padding="8,4" Command="{x:Bind ViewModel.ResetTimerCommand}" />
                    </StackPanel>

                    <!-- Pocket Shelf & AI Agent Approval Zone -->
                    <Grid Grid.Row="1" Margin="4,0" Background="#331E293B" CornerRadius="8" Padding="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Agent Approval Required Banner -->
                        <Grid Grid.Row="0" Margin="0,0,0,6" Background="#33F59E0B" CornerRadius="6" Padding="6"
                              Visibility="{x:Bind ViewModel.Approvals.ApprovalCardVisibility, Mode=OneWay}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="#F59E0B" />
                                    <TextBlock Text="Agent Permission Approval" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.Approvals.ActiveRequest.CommandOrAction, Mode=OneWay}"
                                           FontSize="10" Foreground="#E2E8F0" TextWrapping="Wrap" MaxHeight="40" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Allow" FontSize="9" Padding="6,2" Background="#16A34A" Foreground="White" Command="{x:Bind ViewModel.Approvals.ApproveCommand}" />
                                    <Button Content="Deny" FontSize="9" Padding="6,2" Background="#DC2626" Foreground="White" Command="{x:Bind ViewModel.Approvals.DenyCommand}" />
                                    <Button Content="Always Allow" FontSize="9" Padding="6,2" Command="{x:Bind ViewModel.Approvals.RememberRuleCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Spacing="6" Margin="0,0,0,4">
                            <FontIcon Glyph="&#xE8B7;" FontSize="11" Foreground="#A78BFA" />
                            <TextBlock Text="Pocket Shelf &amp; Share" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" />
                        </StackPanel>

                        <!-- Pocket Items List -->
                        <ListView Grid.Row="2"
                                  ItemsSource="{x:Bind ViewModel.PocketItems, Mode=OneWay}"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="File item" FontSize="10" Foreground="#E2E8F0" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Footer -->
                    <Button Grid.Row="2"
                            Content="Collapse"
                            FontSize="10"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0"
                            Padding="12,2"
                            Command="{x:Bind ViewModel.ToggleExpandCommand}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
