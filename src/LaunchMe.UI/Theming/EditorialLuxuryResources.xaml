<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================ -->
    <!-- Pure OLED Midnight Palette                                       -->
    <!-- ================================================================ -->
    <Color x:Key="CanvasVoidColor">#FF080A0F</Color>
    <Color x:Key="BentoSurface1Color">#D90E131F</Color>
    <Color x:Key="ElevatedSurface2Color">#E6161D2E</Color>
    <Color x:Key="ObsidianHudColor">#E8080A0F</Color>
    <Color x:Key="ObsidianDockColor">#E60B0F17</Color>
    <Color x:Key="ObsidianVinylColor">#FF05070B</Color>

    <!-- Neon Halo Accents -->
    <Color x:Key="ElectricCyanColor">#FF00F0FF</Color>
    <Color x:Key="UltraOrchidColor">#FFA855F7</Color>
    <Color x:Key="PhosphorEmeraldColor">#FF00FF9D</Color>
    <Color x:Key="AmberTopazColor">#FFF59E0B</Color>

    <!-- Surface & Accent Brushes -->
    <SolidColorBrush x:Key="CanvasVoidBrush" Color="{StaticResource CanvasVoidColor}" />
    <SolidColorBrush x:Key="BentoSurface1Brush" Color="{StaticResource BentoSurface1Color}" />
    <SolidColorBrush x:Key="ElevatedSurface2Brush" Color="{StaticResource ElevatedSurface2Color}" />
    <SolidColorBrush x:Key="ObsidianHudBrush" Color="{StaticResource ObsidianHudColor}" />
    <SolidColorBrush x:Key="ObsidianDockBrush" Color="{StaticResource ObsidianDockColor}" />
    <SolidColorBrush x:Key="ObsidianVinylBrush" Color="{StaticResource ObsidianVinylColor}" />

    <SolidColorBrush x:Key="ElectricCyanBrush" Color="{StaticResource ElectricCyanColor}" />
    <SolidColorBrush x:Key="UltraOrchidBrush" Color="{StaticResource UltraOrchidColor}" />
    <SolidColorBrush x:Key="PhosphorEmeraldBrush" Color="{StaticResource PhosphorEmeraldColor}" />
    <SolidColorBrush x:Key="AmberTopazBrush" Color="{StaticResource AmberTopazColor}" />

    <SolidColorBrush x:Key="LuxuryTextPrimaryBrush" Color="#FFF8FAFC" />
    <SolidColorBrush x:Key="LuxuryTextSecondaryBrush" Color="#FF94A3B8" />
    <SolidColorBrush x:Key="LuxuryTextMutedBrush" Color="#FF64748B" />
    <SolidColorBrush x:Key="LuxuryDividerBrush" Color="#1FFFFFFF" />

    <!-- ================================================================ -->
    <!-- 0.5px 135-deg Specular Glass Chamfer Border Brushes              -->
    <!-- ================================================================ -->
    <LinearGradientBrush x:Key="SpecularGlassChamferBrush" StartPoint="0.05,0" EndPoint="0.95,1">
        <GradientStop Color="#A6FFFFFF" Offset="0.0" />
        <GradientStop Color="#47FFFFFF" Offset="0.18" />
        <GradientStop Color="#0DFFFFFF" Offset="0.48" />
        <GradientStop Color="#24FFFFFF" Offset="0.80" />
        <GradientStop Color="#05FFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SpecularInnerRimBrush" StartPoint="0.05,0" EndPoint="0.95,1">
        <GradientStop Color="#38FFFFFF" Offset="0.0" />
        <GradientStop Color="#14FFFFFF" Offset="0.35" />
        <GradientStop Color="#08FFFFFF" Offset="0.70" />
        <GradientStop Color="#1CFFFFFF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SpecularCyanHaloBorderBrush" StartPoint="0.05,0" EndPoint="0.95,1">
        <GradientStop Color="#CC00F0FF" Offset="0.0" />
        <GradientStop Color="#5500F0FF" Offset="0.30" />
        <GradientStop Color="#33A855F7" Offset="0.70" />
        <GradientStop Color="#9900F0FF" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SpecularPookieAlertBorderBrush" StartPoint="0.05,0" EndPoint="0.95,1">
        <GradientStop Color="#CCF59E0B" Offset="0.0" />
        <GradientStop Color="#55A855F7" Offset="0.50" />
        <GradientStop Color="#99F59E0B" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ================================================================ -->
    <!-- Segoe UI Variable Display Editorial Typography Styles            -->
    <!-- ================================================================ -->
    <Style x:Key="EditorialHeroMetricStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="CharacterSpacing" Value="-35" />
        <Setter Property="Foreground" Value="#FFF8FAFC" />
    </Style>

    <Style x:Key="EditorialBentoHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Foreground" Value="#FFF8FAFC" />
    </Style>

    <Style x:Key="EditorialMicroEyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Small" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="90" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="#FF94A3B8" />
    </Style>

    <Style x:Key="EditorialMicroBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="BorderThickness" Value="0.5" />
        <Setter Property="UseLayoutRounding" Value="False" />
        <Setter Property="Background" Value="#1A00F0FF" />
        <Setter Property="BorderBrush" Value="{StaticResource SpecularGlassChamferBrush}" />
    </Style>

    <Style x:Key="EditorialMicroBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Small" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="90" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="#FF00F0FF" />
    </Style>
</ResourceDictionary>
