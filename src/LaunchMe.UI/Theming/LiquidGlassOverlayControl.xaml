<UserControl
    x:Class="LaunchMe.UI.Theming.LiquidGlassOverlayControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="OverlayRoot">
        <!-- Acrylic Glass Base Layer -->
        <Border x:Name="GlassBackdropBorder"
                Background="{x:Bind VisualState.BackdropBrush, Mode=OneWay}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

        <!-- Specular Highlight Overlay (Glass Edge Refraction Effect) -->
        <Border x:Name="GlassRefractionBorder"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BorderThickness="1"
                Opacity="0.25">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#80FFFFFF" Offset="0.0" />
                    <GradientStop Color="#10FFFFFF" Offset="0.5" />
                    <GradientStop Color="#00FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>

        <!-- Tint Overlay for custom color adjustments -->
        <Border x:Name="TintOverlayBorder"
                Background="{x:Bind VisualState.TintBrush, Mode=OneWay}"
                Opacity="{x:Bind VisualState.TintOpacity, Mode=OneWay}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

        <!-- Hosted Content Slot -->
        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    </Grid>
</UserControl>
