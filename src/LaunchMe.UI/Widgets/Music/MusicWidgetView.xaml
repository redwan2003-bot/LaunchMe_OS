<UserControl
    x:Class="LaunchMe.UI.Widgets.Music.MusicWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:LaunchMe.UI.Widgets.Music"
    mc:Ignorable="d">

    <Border Background="#20FFFFFF" 
            BorderBrush="#33FFFFFF" 
            BorderThickness="1" 
            CornerRadius="16" 
            Padding="16"
            MinWidth="280"
            MinHeight="130">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top: Thumbnail + Metadata -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Cover Art / Vinyl Icon -->
                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" Background="#331E293B" BorderBrush="#33FFFFFF" BorderThickness="1">
                    <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Title & Artist -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="White" 
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.Artist, Mode=OneWay}" 
                               FontSize="12" 
                               Foreground="#94A3B8" 
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- Middle: Progress Bar & Timestamps -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ProgressBar Grid.Row="0" 
                             Value="{x:Bind ViewModel.ProgressRatio, Mode=OneWay}" 
                             Minimum="0" 
                             Maximum="1" 
                             Foreground="#38BDF8" 
                             Background="#33FFFFFF" 
                             Height="4" 
                             CornerRadius="2" />

                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <TextBlock Text="{x:Bind ViewModel.PositionFormatted, Mode=OneWay}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Left" />
                    <TextBlock Text="{x:Bind ViewModel.DurationFormatted, Mode=OneWay}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" />
                </Grid>
            </Grid>

            <!-- Bottom: Media Controls -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                <!-- Previous -->
                <Button Command="{x:Bind ViewModel.PreviousCommand}" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Padding="6" 
                        CornerRadius="20">
                    <FontIcon Glyph="&#xE892;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#CBD5E1" />
                </Button>

                <!-- Play/Pause -->
                <Button Command="{x:Bind ViewModel.PlayPauseCommand}" 
                        Background="#38BDF8" 
                        BorderThickness="0" 
                        Padding="10" 
                        CornerRadius="22">
                    <FontIcon Glyph="{x:Bind ViewModel.PlayPauseIconGlyph, Mode=OneWay}" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#0F172A" />
                </Button>

                <!-- Next -->
                <Button Command="{x:Bind ViewModel.NextCommand}" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Padding="6" 
                        CornerRadius="20">
                    <FontIcon Glyph="&#xE893;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#CBD5E1" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
