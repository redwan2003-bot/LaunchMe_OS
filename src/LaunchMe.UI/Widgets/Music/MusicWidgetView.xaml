<UserControl
    x:Class="LaunchMe.UI.Widgets.Music.MusicWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:LaunchMe.UI.Widgets.Music"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 1. MINIMAL -->
        <DataTemplate x:Key="MusicMinimalTemplate">
            <Border Background="#20FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="16" Padding="16" MinWidth="280" MinHeight="130">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" Background="#331E293B" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="24" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding TrackTitle}" FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar Grid.Row="1" Value="{Binding ProgressRatio}" Minimum="0" Maximum="1" Foreground="#38BDF8" Background="#33FFFFFF" Height="4" CornerRadius="2" Margin="0,0,0,8" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                        <Button Command="{Binding PreviousCommand}" Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="20">
                            <FontIcon Glyph="&#xE892;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#CBD5E1" />
                        </Button>
                        <Button Command="{Binding PlayPauseCommand}" Background="#38BDF8" BorderThickness="0" Padding="10" CornerRadius="22">
                            <FontIcon Glyph="{Binding PlayPauseIconGlyph}" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#0F172A" />
                        </Button>
                        <Button Command="{Binding NextCommand}" Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="20">
                            <FontIcon Glyph="&#xE893;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#CBD5E1" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 2. FULL COVER -->
        <DataTemplate x:Key="MusicFullCoverTemplate">
            <Border CornerRadius="20" Padding="18" MinWidth="280" MinHeight="160" BorderBrush="#44A855F7" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF1E1B4B" Offset="0.0" />
                        <GradientStop Color="#FF080A0F" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel VerticalAlignment="Bottom" Spacing="6">
                    <TextBlock Text="{Binding TrackTitle}" FontSize="18" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Artist}" FontSize="13" Foreground="#A855F7" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Value="{Binding ProgressRatio}" Minimum="0" Maximum="1" Foreground="#A855F7" Background="#22FFFFFF" Height="3" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 3. VINYL -->
        <DataTemplate x:Key="MusicVinylTemplate">
            <Border Background="#E6080A0F" BorderBrush="#4400F0FF" BorderThickness="1" CornerRadius="20" Padding="16" MinWidth="280">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="64" Height="64">
                        <Ellipse Fill="#FF111827" Stroke="#FF00F0FF" StrokeThickness="1.5" />
                        <Ellipse Width="18" Height="18" Fill="#FFA855F7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{Binding TrackTitle}" FontSize="14" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Artist}" FontSize="11.5" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding PositionFormatted}" FontSize="10" Foreground="#00F0FF" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 4. DYNAMIC ACCENT -->
        <DataTemplate x:Key="MusicDynamicAccentTemplate">
            <Border Background="#2800F0FF" BorderBrush="#FF00F0FF" BorderThickness="1" CornerRadius="18" Padding="16" MinWidth="270">
                <StackPanel Spacing="8">
                    <TextBlock Text="NOW PLAYING" FontSize="9.5" FontWeight="Bold" Foreground="#00F0FF" CharacterSpacing="150" />
                    <TextBlock Text="{Binding TrackTitle}" FontSize="16" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="#E2E8F0" />
                    <Button Content="Play / Pause" Command="{Binding PlayPauseCommand}" Background="#FF00F0FF" Foreground="#05070B" FontWeight="Bold" CornerRadius="10" Padding="12,5" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 5. DYNAMIC SPLIT -->
        <DataTemplate x:Key="MusicDynamicSplitTemplate">
            <Border Background="#D90E131F" BorderBrush="#44FFFFFF" BorderThickness="1" CornerRadius="18" Padding="16" MinWidth="280">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TrackTitle}" FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Album}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding PlayPauseCommand}" Background="#A855F7" Foreground="White" CornerRadius="18" Padding="10">
                        <FontIcon Glyph="{Binding PlayPauseIconGlyph}" FontFamily="Segoe Fluent Icons" FontSize="16" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 6. COMPACT IDLE -->
        <DataTemplate x:Key="MusicCompactIdleTemplate">
            <Border Background="#D9080A0F" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="14" Padding="12,8" MinWidth="220">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#00FF9D" />
                    <TextBlock Text="{Binding TrackTitle}" FontSize="12" FontWeight="SemiBold" Foreground="White" MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PositionFormatted}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <local:MusicStyleTemplateSelector x:Key="MusicStyleSelector"
            MinimalTemplate="{StaticResource MusicMinimalTemplate}"
            FullCoverTemplate="{StaticResource MusicFullCoverTemplate}"
            VinylTemplate="{StaticResource MusicVinylTemplate}"
            DynamicAccentTemplate="{StaticResource MusicDynamicAccentTemplate}"
            DynamicSplitTemplate="{StaticResource MusicDynamicSplitTemplate}"
            CompactIdleTemplate="{StaticResource MusicCompactIdleTemplate}" />
    </UserControl.Resources>

    <ContentPresenter Content="{x:Bind ViewModel, Mode=OneWay}"
                      ContentTemplateSelector="{StaticResource MusicStyleSelector}" />
</UserControl>
