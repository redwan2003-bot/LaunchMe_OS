<UserControl
    x:Class="LaunchMe.UI.Widgets.Weather.WeatherWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:LaunchMe.UI.Widgets.Weather"
    mc:Ignorable="d">

    <Border Background="#20FFFFFF" 
            BorderBrush="#33FFFFFF" 
            BorderThickness="1" 
            CornerRadius="16" 
            Padding="16"
            MinWidth="260"
            MinHeight="140">
        <StackPanel Spacing="12">
            <!-- Header: Location & Condition Glyph -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{x:Bind ViewModel.Location, Mode=OneWay}" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="White" />
                    <TextBlock Text="{x:Bind ViewModel.ConditionText, Mode=OneWay}" 
                               FontSize="12" 
                               Foreground="#94A3B8" />
                </StackPanel>

                <TextBlock Grid.Column="1" 
                           Text="{x:Bind ViewModel.ConditionGlyph, Mode=OneWay}" 
                           FontFamily="Segoe Fluent Icons" 
                           FontSize="28" 
                           Foreground="#F59E0B" 
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Main Temperature & High/Low -->
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.CurrentTemperatureFormatted, Mode=OneWay}" 
                           FontSize="34" 
                           FontWeight="Bold" 
                           Foreground="White" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.HighLowFormatted, Mode=OneWay}" 
                               FontSize="11" 
                               Foreground="#CBD5E1" />
                    <TextBlock Text="{x:Bind ViewModel.HumidityFormatted, Mode=OneWay}" 
                               FontSize="11" 
                               Foreground="#64748B" />
                </StackPanel>
            </StackPanel>

            <!-- 4-Day Forecast Strip -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Forecast, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ForecastItemViewModel">
                        <StackPanel HorizontalAlignment="Center" Spacing="2" MinWidth="48">
                            <TextBlock Text="{x:Bind DayName}" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ConditionGlyph}" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#38BDF8" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind TemperatureRange}" FontSize="10" Foreground="White" HorizontalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
