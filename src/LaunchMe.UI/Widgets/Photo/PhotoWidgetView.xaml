<UserControl
    x:Class="LaunchMe.UI.Widgets.Photo.PhotoWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Width="{x:Bind ViewModel.WidgetWidth, Mode=OneWay}"
            Height="{x:Bind ViewModel.WidgetHeight, Mode=OneWay}"
            Background="{x:Bind ViewModel.BackgroundBrush, Mode=OneWay}"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Padding="8">
        <Grid>
            <Image x:Name="PhotoImage"
                   Stretch="UniformToFill"
                   Visibility="{x:Bind ViewModel.ImageVisibility, Mode=OneWay}" />

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        Visibility="{x:Bind ViewModel.PlaceholderVisibility, Mode=OneWay}">
                <FontIcon Glyph="&#xE8B9;" FontFamily="Segoe Fluent Icons" FontSize="26" Foreground="#94A3B8" HorizontalAlignment="Center" />
                <TextBlock Text="Photo Widget" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.SizeLabel, Mode=OneWay}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Spacing="4">
                <Button Command="{x:Bind ViewModel.ToggleTransparentBackgroundCommand}"
                        Background="#44000000"
                        BorderThickness="0"
                        CornerRadius="6"
                        Padding="6,3"
                        ToolTipService.ToolTip="Toggle transparent background">
                    <FontIcon Glyph="&#xE790;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="White" />
                </Button>
                <Button Command="{x:Bind ViewModel.CycleSizeCommand}"
                        Background="#44000000"
                        BorderThickness="0"
                        CornerRadius="6"
                        Padding="6,3"
                        ToolTipService.ToolTip="Cycle size">
                    <FontIcon Glyph="&#xE740;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="White" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
