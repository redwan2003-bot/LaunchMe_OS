<UserControl
    x:Class="LaunchMe.UI.Widgets.Catalog.WidgetCatalogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:clock="using:LaunchMe.UI.Widgets.Clock"
    xmlns:weather="using:LaunchMe.UI.Widgets.Weather"
    xmlns:music="using:LaunchMe.UI.Widgets.Music"
    xmlns:stats="using:LaunchMe.UI.Widgets.SystemStats"
    xmlns:pomodoro="using:LaunchMe.UI.Widgets.Pomodoro"
    xmlns:affirm="using:LaunchMe.UI.Widgets.Affirmations"
    xmlns:cal="using:LaunchMe.UI.Widgets.Calendar"
    xmlns:pixelart="using:LaunchMe.UI.Widgets.PixelArt"
    xmlns:photo="using:LaunchMe.UI.Widgets.Photo"
    xmlns:shapephoto="using:LaunchMe.UI.Widgets.ShapePhoto"
    xmlns:gif="using:LaunchMe.UI.Widgets.Gif"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="12">
            <!-- Clock + 12-Skin Switcher -->
            <Grid>
                <clock:ClockWidgetView ViewModel="{x:Bind ViewModel.Clock, Mode=OneWay}" />
                <Button Content="↻ Skin" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" FontSize="10" Padding="8,3" CornerRadius="10"
                        Background="#2800F0FF" Foreground="#FF00F0FF" Command="{x:Bind ViewModel.Clock.CycleStyleCommand}" />
            </Grid>

            <!-- Weather + 9-Style Switcher -->
            <Grid>
                <weather:WeatherWidgetView ViewModel="{x:Bind ViewModel.Weather, Mode=OneWay}" />
                <Button Content="↻ Style" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" FontSize="10" Padding="8,3" CornerRadius="10"
                        Background="#28A855F7" Foreground="#FFE9D5FF" Command="{x:Bind ViewModel.Weather.CycleStyleCommand}" />
            </Grid>

            <!-- Music + 6-Style Switcher -->
            <Grid>
                <music:MusicWidgetView ViewModel="{x:Bind ViewModel.Music, Mode=OneWay}" />
                <Button Content="↻ Style" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" FontSize="10" Padding="8,3" CornerRadius="10"
                        Background="#2800FF9D" Foreground="#FF00FF9D" Command="{x:Bind ViewModel.Music.CycleStyleCommand}" />
            </Grid>

            <!-- System Stats -->
            <stats:SystemStatsWidgetView ViewModel="{x:Bind ViewModel.SystemStats, Mode=OneWay}" />

            <!-- Pomodoro -->
            <pomodoro:PomodoroWidgetView ViewModel="{x:Bind ViewModel.Pomodoro, Mode=OneWay}" />

            <!-- Affirmations -->
            <affirm:AffirmationWidgetView ViewModel="{x:Bind ViewModel.Affirmations, Mode=OneWay}" />

            <!-- Calendar -->
            <cal:CalendarWidgetView ViewModel="{x:Bind ViewModel.Calendar, Mode=OneWay}" />

            <!-- Pixel Art -->
            <pixelart:PixelArtWidgetView ViewModel="{x:Bind ViewModel.PixelArt, Mode=OneWay}" />

            <!-- Photo -->
            <photo:PhotoWidgetView ViewModel="{x:Bind ViewModel.Photo, Mode=OneWay}" />

            <!-- Shape Photo -->
            <shapephoto:ShapePhotoWidgetView ViewModel="{x:Bind ViewModel.ShapePhoto, Mode=OneWay}" />

            <!-- Animated GIF -->
            <gif:GifWidgetView ViewModel="{x:Bind ViewModel.Gif, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
