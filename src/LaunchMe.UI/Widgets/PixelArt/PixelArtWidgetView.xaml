<UserControl
    x:Class="LaunchMe.UI.Widgets.PixelArt.PixelArtWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="#20FFFFFF"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Padding="14"
            MinWidth="220">
        <StackPanel Spacing="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.PresetDisplayName, Mode=OneWay}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <TextBlock Text="{x:Bind ViewModel.FrameStatusText, Mode=OneWay}"
                               FontSize="11"
                               Foreground="#94A3B8" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Command="{x:Bind ViewModel.PreviousPresetCommand}"
                            Background="#22FFFFFF"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="6,4">
                        <FontIcon Glyph="&#xE76B;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="White" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.NextPresetCommand}"
                            Background="#22FFFFFF"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="6,4">
                        <FontIcon Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Background="#1A0F172A"
                    CornerRadius="12"
                    Padding="12"
                    HorizontalAlignment="Center">
                <Grid x:Name="PixelSpriteGrid"
                      Width="90"
                      Height="90" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
