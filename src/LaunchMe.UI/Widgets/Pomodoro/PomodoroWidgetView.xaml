<UserControl
    x:Class="LaunchMe.UI.Widgets.Pomodoro.PomodoroWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:LaunchMe.UI.Widgets.Pomodoro"
    mc:Ignorable="d">

    <Border Background="#20FFFFFF" 
            BorderBrush="#33FFFFFF" 
            BorderThickness="1" 
            CornerRadius="16" 
            Padding="16"
            MinWidth="240"
            MinHeight="140">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
            <!-- Header: State Icon + Title + Completed Cycles -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.StateGlyph, Mode=OneWay}" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#F59E0B" VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.StateTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                <Border Background="#33FFFFFF" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.CompletedCycles, Mode=OneWay}" FontSize="11" Foreground="#38BDF8" FontWeight="Bold" />
                </Border>
            </StackPanel>

            <!-- Remaining Countdown Display -->
            <TextBlock Text="{x:Bind ViewModel.RemainingTimeFormatted, Mode=OneWay}" 
                       FontSize="36" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       HorizontalAlignment="Center" />

            <!-- Progress Bar -->
            <ProgressBar Value="{x:Bind ViewModel.ProgressRatio, Mode=OneWay}" 
                         Minimum="0" 
                         Maximum="1" 
                         Foreground="#10B981" 
                         Background="#33FFFFFF" 
                         Height="4" 
                         CornerRadius="2" 
                         HorizontalAlignment="Stretch" />

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <Button Command="{x:Bind ViewModel.ResetCommand}" Background="Transparent" BorderThickness="0" Padding="6">
                    <FontIcon Glyph="&#xE777;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#94A3B8" />
                </Button>
                <Button Command="{x:Bind ViewModel.StartPauseCommand}" Background="#10B981" BorderThickness="0" Padding="12,6" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="{x:Bind ViewModel.StartPauseGlyph, Mode=OneWay}" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="White" />
                        <TextBlock Text="{x:Bind ViewModel.StartPauseButtonText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.SkipCommand}" Background="Transparent" BorderThickness="0" Padding="6">
                    <FontIcon Glyph="&#xE893;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="#94A3B8" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
