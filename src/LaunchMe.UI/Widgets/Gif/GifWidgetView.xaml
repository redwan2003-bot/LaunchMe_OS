<UserControl
    x:Class="LaunchMe.UI.Widgets.Gif.GifWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Width="240"
            Height="180"
            Background="{x:Bind ViewModel.BackgroundBrush, Mode=OneWay}"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Padding="8">
        <Grid>
            <Image x:Name="GifImage"
                   Stretch="Uniform"
                   Visibility="{x:Bind ViewModel.GifVisibility, Mode=OneWay}" />

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        Visibility="{x:Bind ViewModel.PlaceholderVisibility, Mode=OneWay}">
                <FontIcon Glyph="&#xE714;" FontFamily="Segoe Fluent Icons" FontSize="26" Foreground="#94A3B8" HorizontalAlignment="Center" />
                <TextBlock Text="Animated GIF" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.PlaybackStatusText, Mode=OneWay}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" />
            </StackPanel>

            <Button Command="{x:Bind ViewModel.ToggleTransparentBackgroundCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#44000000"
                    BorderThickness="0"
                    CornerRadius="6"
                    Padding="6,3"
                    ToolTipService.ToolTip="Toggle transparent background">
                <FontIcon Glyph="&#xE790;" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="White" />
            </Button>
        </Grid>
    </Border>
</UserControl>
